+int dither[4][4] = {{13, 8, 10, 3}, {1, 12, 6, 15}, {4, 9, 7, 14}, {16, 5, 11, 2}};
+
+/*
+ * Ordered (Bayer 8x8) dithering of lit surfaces in the z-buffer renderer.
+ *
+ * Lit triangles interpolate an intensity that is quantised to a palette-ramp entry (solid colours) or
+ * a shade-table row (lit textures).  The vertex lighting code adds 0.5 to that value so the plain
+ * truncation rounds to nearest.  When dithering is on, the renderer instead adds a screen-position
+ * dependent threshold in [-0.49,+0.49] before truncating, which gives floor(v + threshold) - an ordered dither
+ * that never leaves [zb_dither_lo, zb_dither_hi] (the material's own ramp).
+ */
+#include "brender.h"
+#include "zb.h"
+
+br_int_32 zb_dither_mode = 0;
+br_int_32 zb_dither_lo = 0;
+br_int_32 zb_dither_hi = 255;
+br_int_32 zb_bayer8[8][8];   /* unit-amplitude threshold offsets, 16.16 */
+br_int_32 zb_dither_tab[8][8]; /* the above scaled by zb_dither_amp: what the renderers use */
+br_int_32 zb_dither_amp = 0;
+static int bayer_ready = 0;
+
+static void BuildBayer8(void)
+{
+    int m[8][8], n, x, y;
+
+    m[0][0] = 0;
+    for (n = 1; n < 8; n *= 2)
+    {
+        for (y = 0; y < n; y++)
+        {
+            for (x = 0; x < n; x++)
+            {
+                int v = m[y][x] * 4;
+                m[y][x] = v;
+                m[y][x + n] = v + 2;
+                m[y + n][x] = v + 3;
+                m[y + n][x + n] = v + 1;
+            }
+        }
+    }
+    /* (2v+1)/128 in [0,1) as a threshold, minus the 0.5 already added by the lighting code, in 16.16 */
+    for (y = 0; y < 8; y++)
+        for (x = 0; x < 8; x++)
+            zb_bayer8[y][x] = (2 * m[y][x] + 1) * 512 - 32768;
+    bayer_ready = 1;
+    zb_dither_amp = 0;
+}
+
+/*
+ * Scale the threshold matrix to an amplitude (16.16, 1.0 = one index step).  Solid colours dither across one ramp
+ * entry.  A lit texture goes through a shade table with many more rows than a ramp has entries, so the noise has to span
+ * the several rows that make up one palette step or the table's own posterisation shows as bands.
+ */
+void ZbDitherSetAmp(br_int_32 amp)
+{
+    int x, y;
+
+    if (!bayer_ready || amp == zb_dither_amp)
+        return;
+    for (y = 0; y < 8; y++)
+        for (x = 0; x < 8; x++)
+            zb_dither_tab[y][x] = (br_int_32)(((long long)zb_bayer8[y][x] * amp) >> 16);
+    zb_dither_amp = amp;
+}
+
+void BR_PUBLIC_ENTRY BrZbSetDither(br_int_32 mode)
+{
+    if (mode != BR_ZB_DITHER_NONE && !bayer_ready)
+        BuildBayer8();
+    ZbDitherSetAmp(0x10000);
+    zb_dither_mode = (mode != BR_ZB_DITHER_NONE) ? BR_ZB_DITHER_BAYER8 : BR_ZB_DITHER_NONE;
+}
+
+br_int_32 BR_PUBLIC_ENTRY BrZbGetDither(void)
+{
+    return zb_dither_mode;
+}
