diff --git a/ZB/zb.h b/ZB/zb.h
index 74cc8b8..a46132c 100644
--- a/ZB/zb.h
+++ b/ZB/zb.h
@@ -362,6 +362,22 @@ typedef int screen_scalar;
 
     extern br_zbuffer_state BR_ASM_DATA zb;
 
+    /*
+     * Ordered dither state (dither.c)
+     */
+    extern br_int_32 zb_dither_mode;
+    extern br_int_32 zb_dither_lo, zb_dither_hi;
+    extern br_int_32 zb_bayer8[8][8];
+    extern br_int_32 zb_dither_tab[8][8];
+    void ZbDitherSetAmp(br_int_32 amp);
+
+    /* intensity (16.16, already biased by +0.5) plus the Bayer offset for this pixel, truncated and kept inside the ramp */
+    static inline br_int_32 ZbDitherIndex(br_uint_32 i, br_int_32 off)
+    {
+        br_int_32 v = (br_int_32)(i + (br_uint_32)off) >> 16;
+        return v < zb_dither_lo ? zb_dither_lo : (v > zb_dither_hi ? zb_dither_hi : v);
+    }
+
     /*
      * Transform into screen space - Inline expanded BrMatrix4ApplyP()
      */
