+/***************************************************************************
+    Frame interpolation support.
+
+    During playback the movie advances at a fixed rate, but the view can be
+    drawn more often.  The caller captures the pose before a frame step
+    (slot 0) and after it (slot 1), then calls BlendPoses() to show points
+    in between.  ApplyPose() puts a captured pose back exactly, which the
+    caller must do before the next frame step because the actor code only
+    rewrites a matrix when it thinks that matrix changed.
+***************************************************************************/
+
+// Blends two BRender matrices.  Returns fFalse if they can't be blended.
+static bool _FBlendBmat34(const BMAT34 *pbmat34A, const BMAT34 *pbmat34B, float rFrac, BMAT34 *pbmat34Out)
+{
+    posebld::Mat34 a, b, o;
+    int32_t i, j;
+
+    for (i = 0; i < 4; i++)
+    {
+        for (j = 0; j < 3; j++)
+        {
+            a[i][j] = BrScalarToFloat(pbmat34A->m[i][j]);
+            b[i][j] = BrScalarToFloat(pbmat34B->m[i][j]);
+        }
+    }
+    if (!posebld::FBlend(a, b, rFrac, o))
+        return fFalse;
+    for (i = 0; i < 4; i++)
+    {
+        for (j = 0; j < 3; j++)
+            pbmat34Out->m[i][j] = BrFloatToScalar(o[i][j]);
+    }
+    return fTrue;
+}
+
+/***************************************************************************
+    Releases the pose snapshots and their model references
+***************************************************************************/
+void BODY::_FreePoses(void)
+{
+    AssertBaseThis(0);
+
+    int32_t ipose;
+    int32_t ibact;
+    BODYPOSE *ppose;
+
+    for (ipose = 0; ipose < 2; ipose++)
+    {
+        ppose = &_rgbpose[ipose];
+        if (pvNil != ppose->prgpmodlPart)
+        {
+            for (ibact = 0; ibact < _cbactPosePart; ibact++)
+                ReleasePpo(&ppose->prgpmodlPart[ibact]);
+            FreePpv((void **)&ppose->prgpmodlPart);
+        }
+        FreePpv((void **)&ppose->prgbmat34Part);
+        ppose->fValid = fFalse;
+    }
+    // A part may still be showing one of the scratch models; it holds its own
+    // reference, so releasing ours is safe.
+    if (pvNil != _prgpmodlMorph)
+    {
+        for (ibact = 0; ibact < _cbactPosePart; ibact++)
+            ReleasePpo(&_prgpmodlMorph[ibact]);
+        FreePpv((void **)&_prgpmodlMorph);
+    }
+    _cbactPosePart = 0;
+}
+
+/***************************************************************************
+    Makes sure the pose buffers exist and match the current part count
+***************************************************************************/
+bool BODY::_FEnsurePoseBufs(void)
+{
+    AssertBaseThis(0);
+
+    int32_t ipose;
+    BODYPOSE *ppose;
+
+    if (_cbactPosePart == _cbactPart && pvNil != _rgbpose[0].prgbmat34Part)
+        return fTrue;
+
+    _FreePoses();
+    if (_cbactPart <= 0)
+        return fFalse;
+
+    for (ipose = 0; ipose < 2; ipose++)
+    {
+        ppose = &_rgbpose[ipose];
+        if (!FAllocPv((void **)&ppose->prgbmat34Part, LwMul(_cbactPart, SIZEOF(BMAT34)), fmemClear, mprNormal) ||
+            !FAllocPv((void **)&ppose->prgpmodlPart, LwMul(_cbactPart, SIZEOF(PMODL)), fmemClear, mprNormal))
+        {
+            _FreePoses();
+            return fFalse;
+        }
+    }
+    // Only needed (and only filled in) for parts whose model changes
+    if (!FAllocPv((void **)&_prgpmodlMorph, LwMul(_cbactPart, SIZEOF(PMODL)), fmemClear, mprNormal))
+    {
+        _FreePoses();
+        return fFalse;
+    }
+    _cbactPosePart = _cbactPart;
+    return fTrue;
+}
+
+/***************************************************************************
+    Captures the current pose into slot ipose (0 or 1)
+***************************************************************************/
+void BODY::CapturePose(int32_t ipose)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    BODYPOSE *ppose = &_rgbpose[ipose];
+    int32_t ibact;
+    PBACT pbact;
+    PMODL pmodl;
+
+    if (!_FEnsurePoseBufs())
+    {
+        // Out of memory.  An invalid pose makes the step non-blendable.
+        _rgbpose[ipose].fValid = fFalse;
+        return;
+    }
+
+    ppose = &_rgbpose[ipose];
+    ppose->bmat34Root = _PbactRoot()->t.t.mat;
+    ppose->cactHidden = _cactHidden;
+    for (ibact = 0; ibact < _cbactPart; ibact++)
+    {
+        pbact = _PbactPart(ibact);
+        ppose->prgbmat34Part[ibact] = pbact->t.t.mat;
+
+        // Take the new reference before dropping the old one in case they match
+        pmodl = pvNil;
+        if (pvNil != pbact->model)
+        {
+            pmodl = MODL::PmodlFromBmdl(pbact->model);
+            pmodl->AddRef();
+        }
+        ReleasePpo(&ppose->prgpmodlPart[ibact]);
+        ppose->prgpmodlPart[ibact] = pmodl;
+    }
+    ppose->fValid = fTrue;
+}
+
+/***************************************************************************
+    Compares the two captured poses.  Returns kposeDiscontinuity if they
+    can't be blended, kposeSame if there's nothing to blend, else
+    kposeDiffer.
+***************************************************************************/
+int32_t BODY::DiffPoses(void)
+{
+    AssertThis(0);
+
+    BODYPOSE *ppose0 = &_rgbpose[0];
+    BODYPOSE *ppose1 = &_rgbpose[1];
+    int32_t ibact;
+
+    if (!ppose0->fValid || !ppose1->fValid || _cbactPosePart != _cbactPart)
+        return kposeDiscontinuity;
+
+    // Shown or hidden during the step: that's an appearance, not a motion
+    if (ppose0->cactHidden != ppose1->cactHidden)
+        return kposeDiscontinuity;
+
+    // Hidden for the whole step: nothing to see
+    if (ppose0->cactHidden != 0)
+        return kposeSame;
+
+    if (0 != memcmp(&ppose0->bmat34Root, &ppose1->bmat34Root, SIZEOF(BMAT34)))
+        return kposeDiffer;
+    for (ibact = 0; ibact < _cbactPart; ibact++)
+    {
+        if (ppose0->prgpmodlPart[ibact] != ppose1->prgpmodlPart[ibact])
+            return kposeDiffer;
+        if (0 != memcmp(&ppose0->prgbmat34Part[ibact], &ppose1->prgbmat34Part[ibact], SIZEOF(BMAT34)))
+            return kposeDiffer;
+    }
+    return kposeSame;
+}
+
+/***************************************************************************
+    Shows the pose a fraction rFrac (0 to 1) of the way from slot 0 to
+    slot 1.  Matrices are blended.  Models can't be, so each part uses its
+    slot 0 model for the first half and its slot 1 model for the rest.
+***************************************************************************/
+void BODY::BlendPoses(float rFrac)
+{
+    AssertThis(0);
+    Assert(rFrac >= 0.0f && rFrac <= 1.0f, "bad blend fraction");
+
+    BODYPOSE *ppose0 = &_rgbpose[0];
+    BODYPOSE *ppose1 = &_rgbpose[1];
+    int32_t ibact;
+    PBACT pbact;
+    PMODL pmodl;
+
+    if (!ppose0->fValid || !ppose1->fValid || _cbactPosePart != _cbactPart || _cactHidden != 0)
+        return;
+
+    if (!_FBlendBmat34(&ppose0->bmat34Root, &ppose1->bmat34Root, rFrac, &_PbactRoot()->t.t.mat))
+        _PbactRoot()->t.t.mat = (rFrac < 0.5f) ? ppose0->bmat34Root : ppose1->bmat34Root;
+
+    for (ibact = 0; ibact < _cbactPart; ibact++)
+    {
+        pbact = _PbactPart(ibact);
+
+        if (!_FBlendBmat34(&ppose0->prgbmat34Part[ibact], &ppose1->prgbmat34Part[ibact], rFrac, &pbact->t.t.mat))
+        {
+            pbact->t.t.mat = (rFrac < 0.5f) ? ppose0->prgbmat34Part[ibact] : ppose1->prgbmat34Part[ibact];
+        }
+
+        if (pvNil != ppose0->prgpmodlPart[ibact] && pvNil != ppose1->prgpmodlPart[ibact] &&
+            ppose0->prgpmodlPart[ibact] != ppose1->prgpmodlPart[ibact] &&
+            _FMorphPart(ibact, ppose0->prgpmodlPart[ibact], ppose1->prgpmodlPart[ibact], rFrac))
+        {
+            continue; // the part now has the blended model
+        }
+
+        // The model doesn't change, or can't be blended: switch at the midpoint
+        pmodl = (rFrac < 0.5f) ? ppose0->prgpmodlPart[ibact] : ppose1->prgpmodlPart[ibact];
+        if (pvNil != pmodl)
+            SetPartModel(ibact, pmodl); // does nothing if it's already the part's model
+    }
+
+    AssertPo(_pbwld, 0);
+    _pbwld->MarkDirty(); // need to render
+}
+
+/***************************************************************************
+    Gives part ibact a model that is a fraction rFrac of the way from
+    pmodlFrom to pmodlTo (vertex for vertex, for parts that are animated by
+    swapping between models with the same faces).  Returns fFalse, leaving
+    the part alone, if the two models can't be blended.
+***************************************************************************/
+bool BODY::_FMorphPart(int32_t ibact, PMODL pmodlFrom, PMODL pmodlTo, float rFrac)
+{
+    AssertThis(0);
+    AssertIn(ibact, 0, _cbactPart);
+    AssertPo(pmodlFrom, 0);
+    AssertPo(pmodlTo, 0);
+
+    PMODL pmodlMorph;
+
+    if (pvNil == _prgpmodlMorph || _cbactPosePart != _cbactPart)
+        return fFalse;
+    if (!pmodlFrom->FCanBlend(pmodlTo))
+        return fFalse;
+
+    pmodlMorph = _prgpmodlMorph[ibact];
+    if (pvNil == pmodlMorph || !pmodlMorph->FMorph(pmodlFrom, pmodlTo, rFrac))
+    {
+        // No scratch model yet, or it was made for other faces
+        ReleasePpo(&_prgpmodlMorph[ibact]);
+        pmodlMorph = MODL::PmodlNewMorph(pmodlFrom);
+        if (pvNil == pmodlMorph)
+            return fFalse;
+        _prgpmodlMorph[ibact] = pmodlMorph;
+        if (!pmodlMorph->FMorph(pmodlFrom, pmodlTo, rFrac))
+            return fFalse;
+    }
+
+    SetPartModel(ibact, pmodlMorph);
+    return fTrue;
+}
+
+/***************************************************************************
+    Puts the pose captured in slot ipose back exactly
+***************************************************************************/
+void BODY::ApplyPose(int32_t ipose)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    BODYPOSE *ppose = &_rgbpose[ipose];
+    int32_t ibact;
+    PBACT pbact;
+
+    if (!ppose->fValid || _cbactPosePart != _cbactPart)
+        return;
+
+    _PbactRoot()->t.t.mat = ppose->bmat34Root;
+    for (ibact = 0; ibact < _cbactPart; ibact++)
+    {
+        pbact = _PbactPart(ibact);
+        pbact->t.t.mat = ppose->prgbmat34Part[ibact];
+        if (pvNil != ppose->prgpmodlPart[ibact])
+            SetPartModel(ibact, ppose->prgpmodlPart[ibact]);
+    }
+
+    if (_cactHidden == 0)
+    {
+        AssertPo(_pbwld, 0);
+        _pbwld->MarkDirty(); // need to render
+    }
+}
+
+/***************************************************************************
+    How far the body's origin moved between the two captured poses, in
+    world units.  Returns 0 if either pose is missing.
+***************************************************************************/
+float BODY::RDistPoses(void)
+{
+    AssertThis(0);
+
+    BODYPOSE *ppose0 = &_rgbpose[0];
+    BODYPOSE *ppose1 = &_rgbpose[1];
+    float rDelta;
+    float rSumSq = 0.0f;
+    int32_t j;
+
+    if (!ppose0->fValid || !ppose1->fValid)
+        return 0.0f;
+
+    for (j = 0; j < 3; j++)
+    {
+        rDelta = BrScalarToFloat(ppose1->bmat34Root.m[3][j]) - BrScalarToFloat(ppose0->bmat34Root.m[3][j]);
+        rSumSq += rDelta * rDelta;
+    }
+    return sqrtf(rSumSq);
+}
+
+/***************************************************************************
+    A rough size for the body in the pose captured in slot ipose, in world
+    units: the farthest any part gets from the body's origin, counting the
+    part's own model radius, times the body's overall scale.  The distance
+    to a part is the sum of its offsets up the chain of parents, which can
+    only overestimate it.  This only has to be good to within a factor of
+    two or so.  Returns 0 if the pose is missing.
+***************************************************************************/
+float BODY::RSizePose(int32_t ipose)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    BODYPOSE *ppose = &_rgbpose[ipose];
+    float rMax = 0.0f;
+    float rScale = 0.0f;
+    int32_t ibact;
+    int32_t ibactUp;
+    int32_t cDepth;
+    int32_t i, j;
+
+    if (!ppose->fValid || _cbactPosePart != _cbactPart)
+        return 0.0f;
+
+    // Overall scale: the longest basis vector of the root matrix
+    for (i = 0; i < 3; i++)
+    {
+        float rSumSq = 0.0f;
+        for (j = 0; j < 3; j++)
+        {
+            float r = BrScalarToFloat(ppose->bmat34Root.m[i][j]);
+            rSumSq += r * r;
+        }
+        if (rSumSq > rScale)
+            rScale = rSumSq;
+    }
+    rScale = sqrtf(rScale);
+
+    for (ibact = 0; ibact < _cbactPart; ibact++)
+    {
+        float rReach = 0.0f;
+        float rRadius = 0.0f;
+        PBACT pbact = _PbactPart(ibact);
+
+        // Walk up through the parents to the root (or hilite) BACT.  The
+        // depth limit guards against a corrupt tree.
+        ibactUp = ibact;
+        for (cDepth = 0; cDepth <= _cbactPart; cDepth++)
+        {
+            float rSumSq = 0.0f;
+
+            for (j = 0; j < 3; j++)
+            {
+                float r = BrScalarToFloat(ppose->prgbmat34Part[ibactUp].m[3][j]);
+                rSumSq += r * r;
+            }
+            rReach += sqrtf(rSumSq);
+
+            pbact = _PbactPart(ibactUp)->parent;
+            if (pvNil == pbact)
+                break;
+            ibactUp = (int32_t)(pbact - _prgbact) - 2; // parts start after root and hilite
+            if (ibactUp < 0 || ibactUp >= _cbactPart)
+                break;
+        }
+
+        if (pvNil != ppose->prgpmodlPart[ibact])
+            rRadius = BrScalarToFloat(ppose->prgpmodlPart[ibact]->Pbmdl()->radius);
+
+        if (rReach + rRadius > rMax)
+            rMax = rReach + rRadius;
+    }
+
+    return rMax * rScale;
+}
