+/***************************************************************************
+ *
+ * Handles an alarm between two movie frames, when frame interpolation is
+ * on.  The world has already been rendered with the blended frame that is
+ * due now, so show it, then get the next one ready.  After the last blended
+ * frame the actors are put back at their exact new positions, so the next
+ * movie frame starts from (and shows) exactly what the movie says.
+ *
+ * Parameters:
+ *	tsCur - Time this alarm began being handled.
+ *
+ * Returns:
+ *  fFalse if the next alarm couldn't be set (stop playing), else fTrue.
+ *
+ ***************************************************************************/
+bool MVIE::_FInterpTick(uint32_t tsCur)
+{
+    AssertThis(0);
+    Assert(_isubInterp > 0 && _isubInterp < _cInterp, "no blended frame pending");
+
+    int32_t isub = _isubInterp;
+    int32_t dtim;
+
+    if (_fInterpHold)
+    {
+        // This step couldn't be blended, and the new frame is already
+        // rendered.  Just wait out the rest of the movie frame.
+        _fInterpHold = fFalse;
+        _isubInterp = 0;
+        dtim = kdtimFrame - _DtimInterpOffset(isub, _cInterp);
+    }
+    else
+    {
+        // Show the blended frame for slice isub
+        MarkViews();
+        vpappb->UpdateMarked();
+
+        if (isub + 1 < _cInterp)
+        {
+            Pscen()->BlendPoses((float)(isub + 1) / (float)_cInterp);
+            _isubInterp = isub + 1;
+        }
+        else
+        {
+            Pscen()->ApplyPoses(1);
+            _isubInterp = 0;
+        }
+        Pbwld()->Render();
+        dtim = _DtimInterp(isub, _cInterp);
+    }
+
+    return _clok.FSetAlarm(LwMax(0, dtim - LwMulDivAway((TsCurrent() - tsCur), kdtimSecond, kdtsSecond)), this, 0,
+                           fTrue);
+}
+
+/***************************************************************************
+ *
+ * Abandons any pending blended frames, because playback is stopping.  The
+ * actors have already been advanced to the new movie frame, so they just
+ * need to be put back exactly where the movie says they are.
+ *
+ ***************************************************************************/
+void MVIE::_EndInterp(void)
+{
+    AssertThis(0);
+
+    if (_isubInterp > 0 && !_fInterpHold && Pscen() != pvNil)
+        Pscen()->ApplyPoses(1);
+
+    _isubInterp = 0;
+    _fInterpHold = fFalse;
+}
