+/***************************************************************************
+
+    Frame interpolation support.  Captures the pose of this actor's body into
+    slot ipose (0 = before a frame step, 1 = after), along with the actor
+    state needed to tell a motion from a jump.
+
+    Capturing slot 1 also decides how the step will be shown (see DiffPoses
+    in actor.h), because that needs both poses and the step distance and
+    never changes until the next step:
+
+      kposeDiscontinuity  the actor appeared, disappeared or changed shape;
+                          the whole step can't be blended
+      kposeSame           nothing moved
+      kposeDiffer         a motion; blend it
+      kposeJump           it moved much farther than walking its route
+                          explains (a new subroute, a Move or Tweak event),
+                          so it should stay where it was until the new frame
+
+    rJumpLimit is how far, in multiples of the actor's own size, it may
+    move beyond its step distance and still count as a motion.  0 means
+    never call anything a jump.
+
+***************************************************************************/
+void ACTR::CapturePose(int32_t ipose, float rJumpLimit)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    _rgiaevAddInterp[ipose] = _iaevAddCur;
+    _rgfOnStageInterp[ipose] = FPure(_fOnStage);
+    _pbody->CapturePose(ipose);
+
+    if (ipose == 0)
+    {
+        // Not a complete step until slot 1 is captured
+        _diffInterp = kposeDiscontinuity;
+        return;
+    }
+
+    if (_rgfOnStageInterp[0] != _rgfOnStageInterp[1])
+    {
+        _diffInterp = kposeDiscontinuity;
+        return;
+    }
+
+    _diffInterp = _pbody->DiffPoses();
+    if (_diffInterp != kposeDiffer)
+        return;
+
+    // A new subroute while on stage is how teleporting is recorded
+    if (_rgiaevAddInterp[0] != _rgiaevAddInterp[1])
+    {
+        _diffInterp = kposeJump;
+        return;
+    }
+
+    // Walking the route moves the actor at most one step, so a move well
+    // beyond that (allowing some room for small nudges) was a jump.
+    if (rJumpLimit > 0.0f &&
+        posebld::FIsJump(_pbody->RDistPoses(), BrScalarToFloat(_dwrLastStep), _pbody->RSizePose(0), rJumpLimit))
+    {
+        _diffInterp = kposeJump;
+    }
+}
+
+/***************************************************************************
+
+    Frame interpolation: keeps an actor whose step can't be blended (it
+    appeared or disappeared) as it was before the step, while the rest of the
+    scene is shown between movie frames.  An actor that appeared stays hidden
+    until the new movie frame, one that disappeared stays where it was until
+    then.  Does nothing for other kinds of step.  EndHold undoes this.
+
+***************************************************************************/
+void ACTR::HoldPose(void)
+{
+    AssertThis(0);
+
+    if (_diffInterp != kposeDiscontinuity || _imaskInterp != kimaskNone || _pbody == pvNil)
+        return;
+
+    if (!_rgfOnStageInterp[0] && _rgfOnStageInterp[1] && _fOnStage)
+    {
+        _pbody->Hide(); // not here yet
+        _imaskInterp = kimaskHidden;
+    }
+    else if (_rgfOnStageInterp[0] && !_rgfOnStageInterp[1] && !_fOnStage)
+    {
+        _pbody->ApplyPose(0); // still here
+        _pbody->Show();
+        _imaskInterp = kimaskShown;
+    }
+}
+
+/***************************************************************************
+
+    Frame interpolation: undoes HoldPose, so the actor is as the new movie
+    frame has it.
+
+***************************************************************************/
+void ACTR::EndHold(void)
+{
+    AssertThis(0);
+
+    if (_imaskInterp == kimaskHidden)
+    {
+        _pbody->Show();
+    }
+    else if (_imaskInterp == kimaskShown)
+    {
+        _pbody->ApplyPose(1);
+        _pbody->Hide();
+    }
+    _imaskInterp = kimaskNone;
+}
