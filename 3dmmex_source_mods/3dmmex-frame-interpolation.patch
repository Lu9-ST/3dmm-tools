+/***************************************************************************
+    Remembers the vertices and faces a model is made of (see FCanBlend).
+    If this runs out of memory the model just can't be blended.
+***************************************************************************/
+void MODL::_SaveOriginals(BRV *prgbrv, int32_t cbrv, BRF *prgbrf, int32_t cbrf)
+{
+    AssertBaseThis(0);
+    int32_t i, j;
+    uint32_t luHash = 2166136261U;
+
+    if (cbrv <= 0 || cbrf <= 0 || cbrv > ksuMax || cbrf > ksuMax)
+        return;
+    if (!FAllocPv((void **)&_prgmorv, LwMul(cbrv, SIZEOF(MORV)), fmemClear, mprNormal))
+        return;
+    if (!FAllocPv((void **)&_prgmorf, LwMul(cbrf, SIZEOF(MORF)), fmemClear, mprNormal))
+    {
+        FreePpv((void **)&_prgmorv);
+        return;
+    }
+    _cmorv = cbrv;
+    _cmorf = cbrf;
+
+    for (i = 0; i < cbrv; i++)
+    {
+        for (j = 0; j < 3; j++)
+            _prgmorv[i].rgrPos[j] = prgbrv[i].p.v[j];
+        for (j = 0; j < 2; j++)
+            _prgmorv[i].rgrMap[j] = prgbrv[i].map.v[j];
+    }
+    for (i = 0; i < cbrf; i++)
+    {
+        for (j = 0; j < 3; j++)
+        {
+            _prgmorf[i].rgiv[j] = prgbrf[i].vertices[j];
+            luHash = (luHash ^ prgbrf[i].vertices[j]) * 16777619U;
+        }
+        _prgmorf[i].grfSmooth = prgbrf[i].smoothing;
+        _prgmorf[i].bFlags = prgbrf[i].flags;
+        luHash = (luHash ^ prgbrf[i].smoothing) * 16777619U;
+        luHash = (luHash ^ prgbrf[i].flags) * 16777619U;
+    }
+    _luTopo = luHash ^ (uint32_t)cbrv ^ ((uint32_t)cbrf << 16);
+}
+
+/***************************************************************************
+    Can this model be blended with pmodlOther, vertex for vertex?  Both have
+    to have kept their originals and have the same faces joining the same
+    vertices; where the vertices are and their mapping coordinates may differ.
+***************************************************************************/
+bool MODL::FCanBlend(PMODL pmodlOther)
+{
+    AssertThis(0);
+    AssertPo(pmodlOther, 0);
+    int32_t imorf;
+    MORF *pmorfThis, *pmorfOther;
+
+    if (pvNil == _prgmorv || pvNil == pmodlOther->_prgmorv)
+        return fFalse;
+    if (pmodlOther == this)
+        return fTrue;
+    if (_cmorv != pmodlOther->_cmorv || _cmorf != pmodlOther->_cmorf || _luTopo != pmodlOther->_luTopo)
+        return fFalse;
+
+    // The hash is only a quick check: indexing past the vertices would
+    // be bad, so make sure
+    for (imorf = 0, pmorfThis = _prgmorf, pmorfOther = pmodlOther->_prgmorf; imorf < _cmorf;
+         imorf++, pmorfThis++, pmorfOther++)
+    {
+        if (pmorfThis->rgiv[0] != pmorfOther->rgiv[0] || pmorfThis->rgiv[1] != pmorfOther->rgiv[1] ||
+            pmorfThis->rgiv[2] != pmorfOther->rgiv[2] || pmorfThis->grfSmooth != pmorfOther->grfSmooth ||
+            pmorfThis->bFlags != pmorfOther->bFlags)
+        {
+            return fFalse;
+        }
+    }
+    return fTrue;
+}
+
+/***************************************************************************
+    Makes a scratch model with the vertices and faces of pmodlFrom, to be
+    given the shape of a blend with FMorph.  Unlike the models loaded from
+    files it keeps its originals so it can be updated again and again.
+***************************************************************************/
+PMODL MODL::PmodlNewMorph(PMODL pmodlFrom)
+{
+    AssertPo(pmodlFrom, 0);
+    PMODL pmodl;
+    char szIdentifier[SIZEOF(PMODL) + 1];
+    int32_t i, j;
+    BRV *pbrv;
+    BRF *pbrf;
+
+    if (pvNil == pmodlFrom->_prgmorv)
+        return pvNil;
+
+    pmodl = NewObj MODL;
+    if (pvNil == pmodl)
+        return pvNil;
+
+    // BrModelAllocate copies the name, and a name that ends at the first zero
+    // wouldn't leave room for the pointer
+    FillPb(szIdentifier, SIZEOF(PMODL), 'M');
+    szIdentifier[SIZEOF(PMODL)] = 0;
+    pmodl->_pbmdl = BrModelAllocate(szIdentifier, pmodlFrom->_cmorv, pmodlFrom->_cmorf);
+    if (pvNil == pmodl->_pbmdl)
+        goto LFail;
+    CopyPb(&pmodl, pmodl->_pbmdl->identifier, SIZEOF(PMODL));
+
+    ClearPb(pmodl->_pbmdl->vertices, LwMul(pmodlFrom->_cmorv, SIZEOF(BRV)));
+    ClearPb(pmodl->_pbmdl->faces, LwMul(pmodlFrom->_cmorf, SIZEOF(BRF)));
+    for (i = 0, pbrv = pmodl->_pbmdl->vertices; i < pmodlFrom->_cmorv; i++, pbrv++)
+    {
+        for (j = 0; j < 3; j++)
+            pbrv->p.v[j] = pmodlFrom->_prgmorv[i].rgrPos[j];
+        for (j = 0; j < 2; j++)
+            pbrv->map.v[j] = pmodlFrom->_prgmorv[i].rgrMap[j];
+    }
+    for (i = 0, pbrf = pmodl->_pbmdl->faces; i < pmodlFrom->_cmorf; i++, pbrf++)
+    {
+        for (j = 0; j < 3; j++)
+            pbrf->vertices[j] = pmodlFrom->_prgmorf[i].rgiv[j];
+        pbrf->material = pvNil;
+        pbrf->smoothing = pmodlFrom->_prgmorf[i].grfSmooth;
+        pbrf->flags = pmodlFrom->_prgmorf[i].bFlags;
+    }
+
+    // Don't weld vertices that happen to be in the same place in one frame
+    // and not in another, and keep the vertices and faces for the next update.
+    // The tags say which original vertex each prepared vertex came from, which
+    // is what lets _UpdateMorphed skip the preparing.
+    pmodl->_pbmdl->flags |= BR_MODF_DONT_WELD | BR_MODF_KEEP_ORIGINAL | BR_MODF_GENERATE_TAGS;
+    pmodl->_fMorph = fTrue;
+
+    // Remember what it was made from, so FMorph can tell whether the models
+    // it is asked to blend still have its vertices and faces.
+    if (!FAllocPv((void **)&pmodl->_prgmorv, LwMul(pmodlFrom->_cmorv, SIZEOF(MORV)), fmemClear, mprNormal))
+        goto LFail;
+    CopyPb(pmodlFrom->_prgmorv, pmodl->_prgmorv, LwMul(pmodlFrom->_cmorv, SIZEOF(MORV)));
+    if (!FAllocPv((void **)&pmodl->_prgmorf, LwMul(pmodlFrom->_cmorf, SIZEOF(MORF)), fmemClear, mprNormal))
+        goto LFail;
+    CopyPb(pmodlFrom->_prgmorf, pmodl->_prgmorf, LwMul(pmodlFrom->_cmorf, SIZEOF(MORF)));
+    pmodl->_cmorv = pmodlFrom->_cmorv;
+    pmodl->_cmorf = pmodlFrom->_cmorf;
+    pmodl->_luTopo = pmodlFrom->_luTopo;
+
+    BrModelAdd(pmodl->_pbmdl);
+
+    // If any of this can't be had, FMorph still works, only slower
+    if (FAllocPv((void **)&pmodl->_prgrSum, LwMul(3 * pmodlFrom->_cmorf, SIZEOF(float)), fmemClear, mprNormal))
+        pmodl->_FBuildSums(pmodlFrom);
+    AssertPo(pmodl, 0);
+    return pmodl;
+LFail:
+    ReleasePpo(&pmodl);
+    return pvNil;
+}
+
+/***************************************************************************
+    Gives this model (made by PmodlNewMorph) the shape that is a fraction
+    rFrac of the way from the vertices of pmodlFrom to those of pmodlTo.
+***************************************************************************/
+bool MODL::FMorph(PMODL pmodlFrom, PMODL pmodlTo, float rFrac)
+{
+    AssertThis(0);
+    AssertPo(pmodlFrom, 0);
+    AssertPo(pmodlTo, 0);
+    int32_t i, j;
+    BRV *pbrv;
+    MORV *pmorvFrom, *pmorvTo;
+    float rFrom, rTo;
+
+    // This model has to still have the vertices and faces of pmodlFrom (and
+    // so of pmodlTo), else it would be drawn with the wrong faces
+    if (!_fMorph || !FCanBlend(pmodlFrom) || !pmodlFrom->FCanBlend(pmodlTo) || _pbmdl->nvertices != _cmorv ||
+        _pbmdl->nfaces != _cmorf)
+    {
+        return fFalse;
+    }
+
+    if (rFrac < 0.0f)
+        rFrac = 0.0f;
+    else if (rFrac > 1.0f)
+        rFrac = 1.0f;
+
+    for (i = 0, pbrv = _pbmdl->vertices, pmorvFrom = pmodlFrom->_prgmorv, pmorvTo = pmodlTo->_prgmorv;
+         i < pmodlFrom->_cmorv; i++, pbrv++, pmorvFrom++, pmorvTo++)
+    {
+        for (j = 0; j < 3; j++)
+        {
+            rFrom = BrScalarToFloat(pmorvFrom->rgrPos[j]);
+            rTo = BrScalarToFloat(pmorvTo->rgrPos[j]);
+            pbrv->p.v[j] = BrFloatToScalar(rFrom + (rTo - rFrom) * rFrac);
+        }
+        for (j = 0; j < 2; j++)
+        {
+            rFrom = BrScalarToFloat(pmorvFrom->rgrMap[j]);
+            rTo = BrScalarToFloat(pmorvTo->rgrMap[j]);
+            pbrv->map.v[j] = BrFloatToScalar(rFrom + (rTo - rFrom) * rFrac);
+        }
+    }
+
+    // The faces that smooth together depend on which vertices are in the same
+    // place, which is worked out for the frame this blend starts from
+    if (_pmodlSumsFrom != pmodlFrom)
+        _FBuildSums(pmodlFrom);
+
+    _UpdateMorphed();
+    return fTrue;
+}
+
+struct MORP // a vertex of the original model, to find the ones in the same place
+{
+    BRS rgrPos[3];
+    int32_t iv;
+};
+
+static int _CompareMorp(const void *pv1, const void *pv2)
+{
+    const MORP *pmorp1 = (const MORP *)pv1;
+    const MORP *pmorp2 = (const MORP *)pv2;
+
+    for (int32_t i = 0; i < 3; i++)
+    {
+        if (pmorp1->rgrPos[i] != pmorp2->rgrPos[i])
+            return (pmorp1->rgrPos[i] > pmorp2->rgrPos[i]) ? 1 : -1;
+    }
+    return (pmorp1->iv > pmorp2->iv) - (pmorp1->iv < pmorp2->iv);
+}
+
+/***************************************************************************
+    Works out, once, which faces BRender adds up to get the normal of each
+    prepared vertex, so that _UpdateMorphed can do the same without sorting
+    anything.  BRender adds the normals of the faces that touch the vertex
+    or any other vertex in the same place, as long as the two faces share a
+    smoothing group.  Vertices are in the same place or not depending on the
+    shape, so this is made for the shape of pmodlFrom: the lists have all the
+    faces that could count, and _UpdateMorphed checks that the vertices are
+    still together in the shape it is drawing.
+***************************************************************************/
+bool MODL::_FBuildSums(MODL *pmodlFrom)
+{
+    AssertBaseThis(0);
+    BMDL *pbmdl = _pbmdl;
+    BRF *prgbrf = pbmdl->faces;
+    int32_t cf = pbmdl->nfaces;
+    int32_t cvOrig = pbmdl->nvertices;
+    int32_t cvPrep = pbmdl->nprepared_vertices;
+    int32_t cc = 3 * cf; // corners
+    MORP *prgmorp = pvNil;
+    int32_t *prggid = pvNil;   // group (same place) of each original vertex
+    int32_t *prgoGroup = pvNil; // where each group's corners start in prgcGroup
+    int32_t *prgcGroup = pvNil; // corners (3 * face + vertex), by group
+    int32_t *prgnFill = pvNil;  // fill position for each group
+    int32_t *prgifPrep = pvNil; // prepared face of each face
+    int32_t *prgcFirst = pvNil; // first corner that uses each prepared vertex
+    int32_t *prgoSum = pvNil;
+    uint16_t *prgifSum = pvNil;
+    uint16_t *prgivSum = pvNil;
+    int32_t cGroup = 0;
+    int32_t i, c, e, k, g, ipv, n;
+    bool fRet = fFalse;
+
+    _pmodlSumsFrom = pmodlFrom;
+    FreePpv((void **)&_prgoSum); // until there are new ones, _UpdateMorphed does it the slow way
+    FreePpv((void **)&_prgifSum);
+    FreePpv((void **)&_prgivSum);
+    if (pvNil == pmodlFrom->_prgmorv || pmodlFrom->_cmorv != cvOrig || pmodlFrom->_cmorf != cf)
+        return fFalse;
+    if (pvNil == pbmdl->face_tags || pvNil == prgbrf || cf <= 0 || cvOrig <= 0 || cvPrep <= 0 || cf > ksuMax ||
+        pbmdl->nprepared_faces != cf)
+    {
+        return fFalse;
+    }
+    if (!FAllocPv((void **)&prgmorp, LwMul(cvOrig, SIZEOF(MORP)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prggid, LwMul(cvOrig, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgoGroup, LwMul(cvOrig + 1, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgnFill, LwMul(cvOrig + 1, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgcGroup, LwMul(cc, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgifPrep, LwMul(cf, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgcFirst, LwMul(cvPrep, SIZEOF(int32_t)), fmemClear, mprNormal) ||
+        !FAllocPv((void **)&prgoSum, LwMul(cvPrep + 1, SIZEOF(int32_t)), fmemClear, mprNormal))
+    {
+        goto LDone;
+    }
+
+    // Vertices in the same place share a group
+    for (i = 0; i < cvOrig; i++)
+    {
+        for (k = 0; k < 3; k++)
+            prgmorp[i].rgrPos[k] = pmodlFrom->_prgmorv[i].rgrPos[k];
+        prgmorp[i].iv = i;
+    }
+    qsort(prgmorp, cvOrig, SIZEOF(MORP), _CompareMorp);
+    for (i = 0; i < cvOrig; i++)
+    {
+        if (i > 0 && 0 != memcmp(prgmorp[i].rgrPos, prgmorp[i - 1].rgrPos, SIZEOF(prgmorp[i].rgrPos)))
+            cGroup++;
+        prggid[prgmorp[i].iv] = cGroup;
+    }
+    cGroup++;
+
+    // The corners of the faces, by group
+    for (c = 0; c < cc; c++)
+    {
+        if (prgbrf[c / 3].vertices[c % 3] >= cvOrig)
+            goto LDone;
+        prgoGroup[prggid[prgbrf[c / 3].vertices[c % 3]] + 1]++;
+    }
+    for (g = 0; g < cGroup; g++)
+        prgoGroup[g + 1] += prgoGroup[g];
+    for (c = 0; c < cc; c++)
+    {
+        g = prggid[prgbrf[c / 3].vertices[c % 3]];
+        prgcGroup[prgoGroup[g] + prgnFill[g]++] = c;
+    }
+
+    // Prepared face of each face, prepared vertex of each corner
+    for (i = 0; i < cf; i++)
+        prgifPrep[i] = -1;
+    for (i = 0; i < cf; i++)
+    {
+        if (pbmdl->face_tags[i] >= cf)
+            goto LDone;
+        prgifPrep[pbmdl->face_tags[i]] = i;
+    }
+    for (i = 0; i < cf; i++)
+    {
+        if (prgifPrep[i] < 0)
+            goto LDone;
+    }
+    for (i = 0; i < cvPrep; i++)
+        prgcFirst[i] = -1;
+    for (c = 0; c < cc; c++)
+    {
+        ipv = pbmdl->prepared_faces[prgifPrep[c / 3]].vertices[c % 3];
+        if (ipv >= cvPrep)
+            goto LDone;
+        if (prgcFirst[ipv] < 0)
+            prgcFirst[ipv] = c;
+    }
+
+    // Count, then fill in, the faces of each prepared vertex (those of the
+    // first corner that uses it: the others it was merged with have the same)
+    for (i = 0; i < cvPrep; i++)
+    {
+        c = prgcFirst[i];
+        if (c < 0)
+            goto LDone;
+        g = prggid[prgbrf[c / 3].vertices[c % 3]];
+        n = 0;
+        for (k = prgoGroup[g]; k < prgoGroup[g + 1]; k++)
+        {
+            if (prgbrf[prgcGroup[k] / 3].smoothing & prgbrf[c / 3].smoothing)
+                n++;
+        }
+        prgoSum[i + 1] = prgoSum[i] + n;
+    }
+    if (!FAllocPv((void **)&prgifSum, LwMul(prgoSum[cvPrep] > 0 ? prgoSum[cvPrep] : 1, SIZEOF(uint16_t)), fmemClear,
+                  mprNormal) ||
+        !FAllocPv((void **)&prgivSum, LwMul(prgoSum[cvPrep] > 0 ? prgoSum[cvPrep] : 1, SIZEOF(uint16_t)), fmemClear,
+                  mprNormal))
+    {
+        goto LDone;
+    }
+    for (i = 0; i < cvPrep; i++)
+    {
+        c = prgcFirst[i];
+        g = prggid[prgbrf[c / 3].vertices[c % 3]];
+        n = prgoSum[i];
+        for (k = prgoGroup[g]; k < prgoGroup[g + 1]; k++)
+        {
+            e = prgcGroup[k];
+            if (prgbrf[e / 3].smoothing & prgbrf[c / 3].smoothing)
+            {
+                prgivSum[n] = prgbrf[e / 3].vertices[e % 3];
+                prgifSum[n++] = (uint16_t)prgifPrep[e / 3];
+            }
+        }
+    }
+
+    _prgoSum = prgoSum;
+    _prgifSum = prgifSum;
+    _prgivSum = prgivSum;
+    prgoSum = pvNil;
+    prgifSum = pvNil;
+    prgivSum = pvNil;
+    fRet = fTrue;
+
+LDone:
+    FreePpv((void **)&prgmorp);
+    FreePpv((void **)&prggid);
+    FreePpv((void **)&prgoGroup);
+    FreePpv((void **)&prgnFill);
+    FreePpv((void **)&prgcGroup);
+    FreePpv((void **)&prgifPrep);
+    FreePpv((void **)&prgcFirst);
+    FreePpv((void **)&prgoSum);
+    FreePpv((void **)&prgifSum);
+    FreePpv((void **)&prgivSum);
+    return fRet;
+}
+
+/***************************************************************************
+    Brings the prepared vertices and faces of a morph model up to date with
+    its (just changed) original vertices.  BrModelUpdate(BR_MODU_ALL) would
+    sort and weld everything again, which costs far too much to do for every
+    frame that's drawn.  The faces and which vertex is which don't change
+    from one blend to the next, so only positions, mapping coordinates and
+    normals are redone, the way BRender's own normals-only update does it
+    (but that one leaves the last face out of the vertex normals).
+***************************************************************************/
+void MODL::_UpdateMorphed(void)
+{
+    AssertBaseThis(0);
+    BMDL *pbmdl = _pbmdl;
+    int32_t iv, ibrf, cv, j;
+    BRV *pbrv;
+    BRF *pbrf;
+    float *prgrSum;
+
+    cv = pbmdl->nprepared_vertices;
+    if (pvNil == pbmdl->vertex_tags || pvNil == pbmdl->prepared_vertices || pvNil == pbmdl->prepared_faces ||
+        pbmdl->nprepared_faces != pbmdl->nfaces || cv <= 0 || pvNil == _prgoSum || pvNil == _prgifSum ||
+        pvNil == _prgivSum || pvNil == _prgrSum)
+    {
+        BrModelUpdate(pbmdl, BR_MODU_ALL); // no way to tell which vertex is which: do it all
+        return;
+    }
+    prgrSum = _prgrSum;
+
+    // Positions and mapping coordinates
+    for (iv = 0, pbrv = pbmdl->prepared_vertices; iv < cv; iv++, pbrv++)
+    {
+        BRV *pbrvOrig = &pbmdl->vertices[pbmdl->vertex_tags[iv]];
+        pbrv->p = pbrvOrig->p;
+        pbrv->map = pbrvOrig->map;
+    }
+
+    // Face normals and plane equations (the same arithmetic as BRender's)
+    for (ibrf = 0, pbrf = pbmdl->prepared_faces; ibrf < pbmdl->nprepared_faces; ibrf++, pbrf++)
+    {
+        BRV *pbrv0 = &pbmdl->prepared_vertices[pbrf->vertices[0]];
+        BRV *pbrv1 = &pbmdl->prepared_vertices[pbrf->vertices[1]];
+        BRV *pbrv2 = &pbmdl->prepared_vertices[pbrf->vertices[2]];
+        float rax = BrScalarToFloat(pbrv1->p.v[0] - pbrv0->p.v[0]);
+        float ray = BrScalarToFloat(pbrv1->p.v[1] - pbrv0->p.v[1]);
+        float raz = BrScalarToFloat(pbrv1->p.v[2] - pbrv0->p.v[2]);
+        float rbx = BrScalarToFloat(pbrv2->p.v[0] - pbrv0->p.v[0]);
+        float rby = BrScalarToFloat(pbrv2->p.v[1] - pbrv0->p.v[1]);
+        float rbz = BrScalarToFloat(pbrv2->p.v[2] - pbrv0->p.v[2]);
+        float rnx = ray * rbz - raz * rby;
+        float rny = raz * rbx - rax * rbz;
+        float rnz = rax * rby - ray * rbx;
+        float rl = sqrtf(rnx * rnx + rny * rny + rnz * rnz);
+
+        if (rl != 0.0f)
+        {
+            rnx /= rl;
+            rny /= rl;
+            rnz /= rl;
+        }
+        else
+        {
+            rnx = 0.0f;
+            rny = 0.0f;
+            rnz = 1.0f;
+        }
+        pbrf->n.v[0] = BR_FRACTION(rnx);
+        pbrf->n.v[1] = BR_FRACTION(rny);
+        pbrf->n.v[2] = BR_FRACTION(rnz);
+        pbrf->d = BrFloatToScalar(rnx * BrScalarToFloat(pbrv0->p.v[0]) + rny * BrScalarToFloat(pbrv0->p.v[1]) +
+                                  rnz * BrScalarToFloat(pbrv0->p.v[2]));
+        prgrSum[3 * ibrf] = rnx;
+        prgrSum[3 * ibrf + 1] = rny;
+        prgrSum[3 * ibrf + 2] = rnz;
+    }
+
+    // Vertex normals: add up the faces BRender does (see _FBuildSums)
+    for (iv = 0, pbrv = pbmdl->prepared_vertices; iv < cv; iv++, pbrv++)
+    {
+        float rx = 0.0f, ry = 0.0f, rz = 0.0f, rl;
+        BRS *prgrHere = pbmdl->vertices[pbmdl->vertex_tags[iv]].p.v;
+
+        for (j = _prgoSum[iv]; j < _prgoSum[iv + 1]; j++)
+        {
+            // Only the faces at vertices that are (still) in the same place
+            BRS *prgrThere = pbmdl->vertices[_prgivSum[j]].p.v;
+            if (prgrThere[0] != prgrHere[0] || prgrThere[1] != prgrHere[1] || prgrThere[2] != prgrHere[2])
+                continue;
+            rx += prgrSum[3 * _prgifSum[j]];
+            ry += prgrSum[3 * _prgifSum[j] + 1];
+            rz += prgrSum[3 * _prgifSum[j] + 2];
+        }
+        rl = sqrtf(rx * rx + ry * ry + rz * rz);
+        if (rl != 0.0f)
+        {
+            rx /= rl;
+            ry /= rl;
+            rz /= rl;
+        }
+        else
+        {
+            rx = 0.0f;
+            ry = 0.0f;
+            rz = 1.0f;
+        }
+        pbrv->n.v[0] = BR_FRACTION(rx);
+        pbrv->n.v[1] = BR_FRACTION(ry);
+        pbrv->n.v[2] = BR_FRACTION(rz);
+    }
+
+    // Bounding radius and box (from the originals; cheap)
+    BrModelUpdate(pbmdl, BR_MODU_RADIUS | BR_MODU_BOUNDING_BOX);
+}
