+/****************************************************
+ *
+ * Frame interpolation: captures every actor's pose into slot ipose.
+ * Capturing slot 1 also classifies each actor's step (see ACTR::CapturePose).
+ *
+ * Parameters:
+ *  ipose - 0 before stepping a frame, 1 after.
+ *  rJumpLimit - How far an actor may move, in multiples of its own size
+ *      beyond its step distance, before it counts as having jumped.
+ *      0 means never.
+ *
+ ****************************************************/
+void SCEN::CapturePoses(int32_t ipose, float rJumpLimit)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    PACTR pactr;
+    int32_t iactr;
+
+    for (iactr = 0; iactr < _pglpactr->IvMac(); iactr++)
+    {
+        _pglpactr->Get(iactr, &pactr);
+        AssertPo(pactr, 0);
+        pactr->CapturePose(ipose, rJumpLimit);
+    }
+}
+
+/****************************************************
+ *
+ * Frame interpolation: decides whether the step between the poses captured
+ * in slots 0 and 1 can be shown as blended frames.
+ *
+ * Returns:
+ *  kposeDiffer if at least one actor moved smoothly (blend it; actors that
+ *      jumped, appeared, disappeared or changed shape are held as they were
+ *      until the new frame, the rest don't move),
+ *  kposeSame if there is nothing to blend (and so the step is just shown at
+ *      the new frame).
+ *
+ ****************************************************/
+int32_t SCEN::DiffPoses(void)
+{
+    AssertThis(0);
+
+    PACTR pactr;
+    int32_t iactr;
+    int32_t diff;
+    int32_t diffScene = kposeSame;
+
+    for (iactr = 0; iactr < _pglpactr->IvMac(); iactr++)
+    {
+        _pglpactr->Get(iactr, &pactr);
+        AssertPo(pactr, 0);
+        diff = pactr->DiffPoses();
+        if (diff == kposeDiffer)
+            diffScene = kposeDiffer;
+    }
+    return diffScene;
+}
+
+/****************************************************
+ *
+ * Frame interpolation: puts every moving actor a fraction rFrac (0 to 1)
+ * of the way from its slot 0 pose to its slot 1 pose.  Actors that jumped
+ * are kept at their slot 0 pose, so they pop to the new place when the
+ * movie frame changes, not early; actors that appeared or disappeared are
+ * kept hidden or visible until then too.  Actors that didn't move are left
+ * alone so they don't need re-rendering.
+ *
+ ****************************************************/
+void SCEN::BlendPoses(float rFrac)
+{
+    AssertThis(0);
+
+    PACTR pactr;
+    int32_t iactr;
+    int32_t diff;
+
+    for (iactr = 0; iactr < _pglpactr->IvMac(); iactr++)
+    {
+        _pglpactr->Get(iactr, &pactr);
+        AssertPo(pactr, 0);
+        diff = pactr->DiffPoses();
+        if (diff == kposeDiffer)
+            pactr->BlendPose(rFrac);
+        else if (diff == kposeJump)
+            pactr->ApplyPose(0);
+        else if (diff == kposeDiscontinuity)
+            pactr->HoldPose();
+    }
+}
+
+/****************************************************
+ *
+ * Frame interpolation: restores every moving or jumping actor to the pose
+ * captured in slot ipose exactly, and lets actors held back by BlendPoses
+ * appear or disappear.  Callers must do this (with slot 1) before the next
+ * frame step.
+ *
+ ****************************************************/
+void SCEN::ApplyPoses(int32_t ipose)
+{
+    AssertThis(0);
+    AssertIn(ipose, 0, 2);
+
+    PACTR pactr;
+    int32_t iactr;
+    int32_t diff;
+
+    for (iactr = 0; iactr < _pglpactr->IvMac(); iactr++)
+    {
+        _pglpactr->Get(iactr, &pactr);
+        AssertPo(pactr, 0);
+        diff = pactr->DiffPoses();
+        if (diff == kposeDiffer || diff == kposeJump)
+            pactr->ApplyPose(ipose);
+        pactr->EndHold(); // does nothing unless BlendPoses held this actor back
+    }
+}
