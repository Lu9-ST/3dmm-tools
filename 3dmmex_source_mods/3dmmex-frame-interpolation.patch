diff --git a/inc/posebld.h b/inc/posebld.h
new file mode 100644
index 0000000..af8ebba
--- /dev/null
+++ b/inc/posebld.h
@@ -0,0 +1,300 @@
+/* Copyright (c) Microsoft Corporation.
+   Licensed under the MIT License. */
+
+/***************************************************************************
+
+    posebld.h: Pose blending math for frame interpolation.
+
+    Blends two affine 3x4 matrices (BRender br_matrix34 layout, row-vector
+    convention: p' = p * M[0..2][*] + M[3][*]) by decomposing each into a
+    rotation, a lower-triangular scale/shear part and a translation.  The
+    rotations are slerped, everything else is lerped.  Decomposing instead
+    of lerping the raw matrix entries avoids the shrinking/shearing that
+    a plain matrix lerp produces in the middle of a rotation.
+
+    This header deliberately has no dependency on BRender or Kauai so the
+    math can be unit tested on its own.
+
+***************************************************************************/
+#ifndef POSEBLD_H
+#define POSEBLD_H
+
+#include <math.h>
+#include <stdint.h>
+
+namespace posebld
+{
+
+// Rows of the 3x3 part are the (scaled) basis vectors; row 3 is translation.
+typedef float Mat34[4][3];
+
+struct Decomp
+{
+    float q[4];    // unit quaternion (x, y, z, w) of the rotation
+    float u[3][3]; // lower-triangular scale/shear: row i of M = sum_{j<=i} u[i][j] * R_row_j
+    float t[3];    // translation
+    bool fMirror;  // the matrix mirrors (negative determinant)
+};
+
+namespace detail
+{
+
+inline float Dot3(const float *a, const float *b)
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+inline float Len3(const float *a)
+{
+    return sqrtf(Dot3(a, a));
+}
+
+// Rotation rows -> quaternion.  rr[i] is row i of the row-vector rotation
+// matrix, which is the transpose of the usual column-vector matrix.
+inline void QuatFromRows(const float rr[3][3], float q[4])
+{
+    // Column-vector matrix c[i][j] = rr[j][i]
+    float c00 = rr[0][0], c01 = rr[1][0], c02 = rr[2][0];
+    float c10 = rr[0][1], c11 = rr[1][1], c12 = rr[2][1];
+    float c20 = rr[0][2], c21 = rr[1][2], c22 = rr[2][2];
+    float trace = c00 + c11 + c22;
+    float x, y, z, w;
+
+    if (trace > 0.0f)
+    {
+        float s = 0.5f / sqrtf(trace + 1.0f);
+        w = 0.25f / s;
+        x = (c21 - c12) * s;
+        y = (c02 - c20) * s;
+        z = (c10 - c01) * s;
+    }
+    else if (c00 > c11 && c00 > c22)
+    {
+        float s = 2.0f * sqrtf(1.0f + c00 - c11 - c22);
+        w = (c21 - c12) / s;
+        x = 0.25f * s;
+        y = (c01 + c10) / s;
+        z = (c02 + c20) / s;
+    }
+    else if (c11 > c22)
+    {
+        float s = 2.0f * sqrtf(1.0f + c11 - c00 - c22);
+        w = (c02 - c20) / s;
+        x = (c01 + c10) / s;
+        y = 0.25f * s;
+        z = (c12 + c21) / s;
+    }
+    else
+    {
+        float s = 2.0f * sqrtf(1.0f + c22 - c00 - c11);
+        w = (c10 - c01) / s;
+        x = (c02 + c20) / s;
+        y = (c12 + c21) / s;
+        z = 0.25f * s;
+    }
+
+    float n = sqrtf(x * x + y * y + z * z + w * w);
+    q[0] = x / n;
+    q[1] = y / n;
+    q[2] = z / n;
+    q[3] = w / n;
+}
+
+// Quaternion -> rotation rows (row-vector convention)
+inline void RowsFromQuat(const float q[4], float rr[3][3])
+{
+    float x = q[0], y = q[1], z = q[2], w = q[3];
+    float c[3][3];
+
+    c[0][0] = 1.0f - 2.0f * (y * y + z * z);
+    c[0][1] = 2.0f * (x * y - z * w);
+    c[0][2] = 2.0f * (x * z + y * w);
+    c[1][0] = 2.0f * (x * y + z * w);
+    c[1][1] = 1.0f - 2.0f * (x * x + z * z);
+    c[1][2] = 2.0f * (y * z - x * w);
+    c[2][0] = 2.0f * (x * z - y * w);
+    c[2][1] = 2.0f * (y * z + x * w);
+    c[2][2] = 1.0f - 2.0f * (x * x + y * y);
+
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 3; j++)
+            rr[j][i] = c[i][j];
+}
+
+inline void Slerp(const float a[4], const float b[4], float t, float out[4])
+{
+    float bb[4] = {b[0], b[1], b[2], b[3]};
+    float d = a[0] * bb[0] + a[1] * bb[1] + a[2] * bb[2] + a[3] * bb[3];
+
+    // Take the short way around
+    if (d < 0.0f)
+    {
+        d = -d;
+        for (int i = 0; i < 4; i++)
+            bb[i] = -bb[i];
+    }
+
+    float wa, wb;
+    if (d > 0.9995f)
+    {
+        // Nearly parallel: normalized lerp is accurate and avoids dividing by ~0
+        wa = 1.0f - t;
+        wb = t;
+    }
+    else
+    {
+        float theta = acosf(d);
+        float sinTheta = sinf(theta);
+        wa = sinf((1.0f - t) * theta) / sinTheta;
+        wb = sinf(t * theta) / sinTheta;
+    }
+
+    float n = 0.0f;
+    for (int i = 0; i < 4; i++)
+    {
+        out[i] = wa * a[i] + wb * bb[i];
+        n += out[i] * out[i];
+    }
+    n = sqrtf(n);
+    for (int i = 0; i < 4; i++)
+        out[i] /= n;
+}
+
+} // namespace detail
+
+/***************************************************************************
+    Decompose m into rotation * scale/shear + translation.  Returns false if
+    the matrix is (nearly) singular, in which case there is no meaningful
+    way to blend it.
+***************************************************************************/
+inline bool FDecompose(const Mat34 m, Decomp *pd)
+{
+    const float kEps = 1e-6f;
+    float r[3][3];
+    float v[3];
+    int i, j;
+
+    // Gram-Schmidt on the rows
+    float n0 = detail::Len3(m[0]);
+    if (n0 < kEps)
+        return false;
+    for (j = 0; j < 3; j++)
+        r[0][j] = m[0][j] / n0;
+
+    float d10 = detail::Dot3(m[1], r[0]);
+    for (j = 0; j < 3; j++)
+        v[j] = m[1][j] - d10 * r[0][j];
+    float n1 = detail::Len3(v);
+    if (n1 < kEps)
+        return false;
+    for (j = 0; j < 3; j++)
+        r[1][j] = v[j] / n1;
+
+    float d20 = detail::Dot3(m[2], r[0]);
+    float d21 = detail::Dot3(m[2], r[1]);
+    for (j = 0; j < 3; j++)
+        v[j] = m[2][j] - d20 * r[0][j] - d21 * r[1][j];
+    float n2 = detail::Len3(v);
+    if (n2 < kEps)
+        return false;
+    for (j = 0; j < 3; j++)
+        r[2][j] = v[j] / n2;
+
+    // Make sure R is a proper rotation.  A reflection ends up as a negative
+    // u[2][2] instead.
+    float det = r[0][0] * (r[1][1] * r[2][2] - r[1][2] * r[2][1]) - r[0][1] * (r[1][0] * r[2][2] - r[1][2] * r[2][0]) +
+                r[0][2] * (r[1][0] * r[2][1] - r[1][1] * r[2][0]);
+    pd->fMirror = (det < 0.0f);
+    if (pd->fMirror)
+    {
+        for (j = 0; j < 3; j++)
+            r[2][j] = -r[2][j];
+    }
+
+    for (i = 0; i < 3; i++)
+        for (j = 0; j < 3; j++)
+            pd->u[i][j] = (j <= i) ? detail::Dot3(m[i], r[j]) : 0.0f;
+
+    detail::QuatFromRows(r, pd->q);
+    for (j = 0; j < 3; j++)
+        pd->t[j] = m[3][j];
+    return true;
+}
+
+inline void Compose(const Decomp &d, Mat34 m)
+{
+    float r[3][3];
+    detail::RowsFromQuat(d.q, r);
+
+    for (int i = 0; i < 3; i++)
+    {
+        for (int k = 0; k < 3; k++)
+        {
+            float s = 0.0f;
+            for (int j = 0; j <= i; j++)
+                s += d.u[i][j] * r[j][k];
+            m[i][k] = s;
+        }
+    }
+    for (int k = 0; k < 3; k++)
+        m[3][k] = d.t[k];
+}
+
+/***************************************************************************
+    Blend a -> b at fraction t in [0, 1].  Returns false if either matrix
+    can't be decomposed, or if one mirrors and the other doesn't (blending
+    those would pass through a flattened, zero-determinant matrix).  The
+    caller should fall back to showing one of the endpoints in that case.
+***************************************************************************/
+inline bool FBlend(const Mat34 a, const Mat34 b, float t, Mat34 out)
+{
+    Decomp da, db, d;
+
+    if (!FDecompose(a, &da) || !FDecompose(b, &db) || da.fMirror != db.fMirror)
+        return false;
+
+    detail::Slerp(da.q, db.q, t, d.q);
+    for (int i = 0; i < 3; i++)
+    {
+        for (int j = 0; j < 3; j++)
+            d.u[i][j] = da.u[i][j] + (db.u[i][j] - da.u[i][j]) * t;
+        d.t[i] = da.t[i] + (db.t[i] - da.t[i]) * t;
+    }
+    Compose(d, out);
+    return true;
+}
+
+/***************************************************************************
+    Timing for splitting one movie frame of dtimFrame clock ticks into cSub
+    slices.  Each slice boundary is rounded to a whole tick on its own, so
+    the slices always add up to exactly one frame and none is longer than
+    one tick more than its share.  (cSub can't exceed dtimFrame: a slice
+    can't be shorter than one tick.)
+***************************************************************************/
+inline int32_t DtimSliceOffset(int32_t isub, int32_t cSub, int32_t dtimFrame)
+{
+    return (isub * dtimFrame + cSub / 2) / cSub;
+}
+inline int32_t DtimSlice(int32_t isub, int32_t cSub, int32_t dtimFrame)
+{
+    return DtimSliceOffset(isub + 1, cSub, dtimFrame) - DtimSliceOffset(isub, cSub, dtimFrame);
+}
+
+/***************************************************************************
+    Did an actor jump rather than move?  rDist is how far its origin moved in
+    one movie frame, rStep how far walking its route can carry it in a frame,
+    rSize roughly how big the actor is, and rLimit how many actor sizes of
+    movement beyond the step still count as a motion (0 turns jump detection
+    off).  Walking never moves an actor more than rStep, so a move well past
+    that is a teleport, a Move or Tweak event, or a new subroute.
+***************************************************************************/
+inline bool FIsJump(float rDist, float rStep, float rSize, float rLimit)
+{
+    if (!(rLimit > 0.0f))
+        return false;
+    return rDist > 1.5f * rStep + rLimit * rSize;
+}
