+ASSERTNAME
+
+#define kftgVxp KLCONST3('v', 'x', 'p')
+#define kftgVxpTemp KLCONST3('v', 't', 'p')
+
+static const char kszVxpPrefix[] = "vxp_";
+static const char kszVxpLog[] = "vxp-log";
+
+// Biggest file we will unpack (it is unpacked in memory)
+static const uint32_t kcbVxpMaxFile = 0x30000000;
+
+// A file in a VXP that has to be unpacked
+struct VXPENT
+{
+    std::string stnFile; // name it is unpacked as (with extension)
+    FTG ftg;
+    zipread::ZipEntry zent;
+    int32_t ivxp; // which VXP it came from (index into the list of VXPs)
+};
+
+static std::string StdLower(std::string s)
+{
+    for (size_t i = 0; i < s.size(); i++)
+    {
+        if (s[i] >= 'A' && s[i] <= 'Z')
+            s[i] = (char)(s[i] - 'A' + 'a');
+    }
+    return s;
+}
+
+static bool FEndsWith(const std::string &s, const char *pszEnd)
+{
+    size_t cch = strlen(pszEnd);
+    return s.size() >= cch && s.compare(s.size() - cch, cch, pszEnd) == 0;
+}
+
+static std::string StdFormat(const char *pszFmt, ...)
+{
+    char sz[1024];
+    va_list args;
+    va_start(args, pszFmt);
+    vsnprintf(sz, sizeof(sz), pszFmt, args);
+    va_end(args);
+    return sz;
+}
+
+// Makes a name that is safe in a file name on any platform
+static std::string StdSafeName(const std::string &s)
+{
+    std::string sOut;
+    for (size_t i = 0; i < s.size() && sOut.size() < 32; i++)
+    {
+        char ch = s[i];
+        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '_')
+            sOut += ch;
+        else
+            sOut += '_';
+    }
+    if (sOut.empty())
+        sOut = "vxp";
+    return sOut;
+}
+
+// Sets *pfni to the file (name with the extension) in the directory pfniDir
+static bool FFniInDir(PFNI pfniDir, const std::string &stnFile, FNI *pfni)
+{
+    size_t ichDot = stnFile.rfind('.');
+    if (ichDot == std::string::npos)
+        return fFalse;
+    std::string stnBase = stnFile.substr(0, ichDot);
+    std::string stnExt = StdLower(stnFile.substr(ichDot + 1));
+    FTG ftg = 0; // (not ftgNil, which isn't 0)
+    for (size_t i = 0; i < stnExt.size(); i++)
+        ftg = (ftg << 8) | (uint8_t)stnExt[i];
+
+    STN stn;
+    stn.SetSz(stnBase.c_str());
+    *pfni = *pfniDir;
+    return pfni->FSetLeaf(&stn, ftg);
+}
+
+// Reads one VXP's directory and adds the files to unpack to *pvecEnt.
+// Returns fFalse (with a message in *psError) if this isn't a usable zip.
+static bool FReadVxp(PFNI pfni, int32_t ivxp, std::vector<VXPENT> *pvecEnt, std::string *psError)
+{
+    PFIL pfil = FIL::PfilOpen(pfni);
+    bool fRet = fFalse;
+    std::vector<uint8_t> vecTail;
+    std::vector<uint8_t> vecDir;
+    std::vector<zipread::ZipEntry> vecZent;
+    uint32_t ibDir, cbDir, cent;
+    FP fpMac, fpTail;
+    int32_t cbTail;
+    STN stnLeaf;
+    std::string sVxp;
+    int cFound = 0;
+
+    if (pvNil == pfil)
+    {
+        *psError = "can't open the file";
+        return fFalse;
+    }
+    try
+    {
+        fpMac = pfil->FpMac();
+        cbTail = fpMac < 66000 ? fpMac : 66000;
+        fpTail = fpMac - cbTail;
+        vecTail.resize(cbTail);
+        if (cbTail < 22 || !pfil->FReadRgb(vecTail.data(), cbTail, fpTail))
+        {
+            *psError = "can't read the file, or it isn't a zip";
+            goto LDone;
+        }
+        if (!zipread::FFindEocd(vecTail.data(), cbTail, &ibDir, &cbDir, &cent) ||
+            (uint64_t)ibDir + cbDir > (uint64_t)fpMac)
+        {
+            *psError = "not a (plain) zip file";
+            goto LDone;
+        }
+        vecDir.resize(cbDir);
+        if ((cbDir > 0 && !pfil->FReadRgb(vecDir.data(), (int32_t)cbDir, (FP)ibDir)) ||
+            !zipread::FParseDirectory(vecDir.data(), cbDir, cent, &vecZent))
+        {
+            *psError = "damaged zip directory";
+            goto LDone;
+        }
+
+        pfni->GetLeaf(&stnLeaf);
+        sVxp = stnLeaf.Psz();
+        if (FEndsWith(StdLower(sVxp), ".vxp"))
+            sVxp.erase(sVxp.size() - 4);
+        sVxp = StdSafeName(sVxp);
+
+        for (size_t i = 0; i < vecZent.size(); i++)
+        {
+            const zipread::ZipEntry &z = vecZent[i];
+            std::string sName = StdLower(z.name);
+            FTG ftg;
+            const char *pszExt;
+
+            if (FEndsWith(sName, ".3cn"))
+            {
+                ftg = kftgContent;
+                pszExt = "3cn";
+            }
+            else if (FEndsWith(sName, ".3th"))
+            {
+                ftg = kftgThumbDesc;
+                pszExt = "3th";
+            }
+            else
+            {
+                continue;
+            }
+            if (sName.compare(0, 9, "__macosx/") == 0 || sName.find("/._") != std::string::npos)
+                continue;
+            if (z.grf & 1)
+            {
+                *psError = "encrypted zips aren't supported";
+                goto LDone;
+            }
+            if (z.method != 0 && z.method != 8)
+            {
+                *psError = "unsupported compression method";
+                goto LDone;
+            }
+            if (z.cbSize > kcbVxpMaxFile || z.cbPacked > kcbVxpMaxFile)
+            {
+                *psError = "a file inside is too big";
+                goto LDone;
+            }
+            VXPENT ent;
+            ent.stnFile = StdFormat("%s%s_%08x.%s", kszVxpPrefix, sVxp.c_str(), (unsigned)z.crc, pszExt);
+            ent.ftg = ftg;
+            ent.zent = z;
+            ent.ivxp = ivxp;
+            // two entries that are identical in content and name (can't be told apart): keep one
+            bool fDup = fFalse;
+            for (size_t j = 0; j < pvecEnt->size(); j++)
+                fDup = fDup || ((*pvecEnt)[j].stnFile == ent.stnFile);
+            if (!fDup)
+                pvecEnt->push_back(ent);
+            cFound++;
+        }
+        if (cFound == 0)
+        {
+            *psError = "no .3cn or .3th files inside";
+            goto LDone;
+        }
+        fRet = fTrue;
+    }
+    catch (const std::exception &)
+    {
+        *psError = "out of memory";
+        fRet = fFalse;
+    }
+LDone:
+    ReleasePpo(&pfil);
+    return fRet;
+}
+
+// Writes cb bytes to a new file (replacing any old one)
+static bool FWriteFile(PFNI pfni, const uint8_t *pb, uint32_t cb)
+{
+    PFIL pfil = FIL::PfilCreate(pfni);
+    bool fRet = fTrue;
+    uint32_t ib = 0;
+
+    if (pvNil == pfil)
+        return fFalse;
+    while (ib < cb && fRet)
+    {
+        uint32_t cbT = cb - ib < 0x100000 ? cb - ib : 0x100000;
+        fRet = pfil->FWriteRgb(pb + ib, (int32_t)cbT, (FP)ib);
+        ib += cbT;
+    }
+    ReleasePpo(&pfil);
+    return fRet;
+}
+
+// Reads, checks and writes one file of a VXP, to the (temporary) pfniTmp
+static bool FUnpackEntry(PFNI pfniVxp, const VXPENT &ent, PFNI pfniTmp, std::string *psError)
+{
+    PFIL pfil = FIL::PfilOpen(pfniVxp);
+    bool fRet = fFalse;
+    uint8_t rgbHdr[30];
+    uint32_t cbHdr;
+    FP fpMac;
+
+    if (pvNil == pfil)
+    {
+        *psError = "can't open the file";
+        return fFalse;
+    }
+    try
+    {
+        fpMac = pfil->FpMac();
+        if ((uint64_t)ent.zent.ibLocal + 30 > (uint64_t)fpMac ||
+            !pfil->FReadRgb(rgbHdr, 30, (FP)ent.zent.ibLocal) || !zipread::FLocalHeaderSize(rgbHdr, &cbHdr) ||
+            (uint64_t)ent.zent.ibLocal + cbHdr + ent.zent.cbPacked > (uint64_t)fpMac)
+        {
+            *psError = "damaged zip entry";
+            goto LDone;
+        }
+        std::vector<uint8_t> vecPacked(ent.zent.cbPacked);
+        std::vector<uint8_t> vecData(ent.zent.cbSize);
+        if (ent.zent.cbPacked > 0 &&
+            !pfil->FReadRgb(vecPacked.data(), (int32_t)ent.zent.cbPacked, (FP)(ent.zent.ibLocal + cbHdr)))
+        {
+            *psError = "can't read the file";
+            goto LDone;
+        }
+        if (ent.zent.method == 0)
+        {
+            if (ent.zent.cbPacked != ent.zent.cbSize)
+            {
+                *psError = "damaged zip entry";
+                goto LDone;
+            }
+            if (ent.zent.cbSize > 0)
+                memcpy(vecData.data(), vecPacked.data(), ent.zent.cbSize);
+        }
+        else if (!zipread::FInflate(vecPacked.data(), vecPacked.size(), vecData.data(), vecData.size()))
+        {
+            *psError = "damaged compressed data";
+            goto LDone;
+        }
+        if (zipread::Crc32(vecData.data(), vecData.size()) != ent.zent.crc)
+        {
+            *psError = "crc mismatch";
+            goto LDone;
+        }
+        if (!FWriteFile(pfniTmp, vecData.data(), (uint32_t)vecData.size()))
+        {
+            *psError = "can't write the file";
+            goto LDone;
+        }
+        fRet = fTrue;
+    }
+    catch (const std::exception &)
+    {
+        *psError = "out of memory";
+        fRet = fFalse;
+    }
+LDone:
+    ReleasePpo(&pfil);
+    return fRet;
+}
+
+// The directory 3DMM reads the "Expansions" source from, the same way TAGM
+// finds it: the long name first, then the short one.
+static bool FFindExpansionsDir(PFNI pfniMsKids, bool fCreate, FNI *pfniOut)
+{
+    STN stnLong = PszLit("Expansions");
+    STN stnShort = PszLit("EXPANSIONS");
+
+    *pfniOut = *pfniMsKids;
+    if (pfniOut->FDownDir(&stnLong, ffniMoveToDir))
+        return fTrue;
+    *pfniOut = *pfniMsKids;
+    if (pfniOut->FDownDir(&stnShort, ffniMoveToDir))
+        return fTrue;
+    if (!fCreate)
+        return fFalse;
+    *pfniOut = *pfniMsKids;
+    return pfniOut->FDownDir(&stnLong, ffniMoveToDir | ffniCreateDir);
+}
+
+static void WriteLog(PFNI pfniVxpDir, const std::vector<std::string> &vecLog)
+{
+    if (vecLog.empty())
+        return;
+    std::string s = "3DMMEx VXP loader\n\n";
+    for (size_t i = 0; i < vecLog.size(); i++)
+        s += vecLog[i] + "\n";
+
+    FNI fni;
+    if (!FFniInDir(pfniVxpDir, std::string(kszVxpLog) + ".txt", &fni))
+        return;
+    // ignore failure (the folder may be read only)
+    (void)FWriteFile(&fni, (const uint8_t *)s.data(), (uint32_t)s.size());
+}
+
+// Reports chunks that are in more than one of the unpacked .3cn files.  3DMM
+// uses the first one it finds, so only one of them is seen.
+static int32_t CConflicts(PFNI pfniDir, const std::vector<VXPENT> &vecEnt, std::vector<std::string> *pvecLog)
+{
+    std::map<std::pair<uint32_t, uint32_t>, int32_t> mpOwner; // (ctg, cno) -> index in vecEnt
+    int32_t cConflicts = 0;
+
+    for (size_t ient = 0; ient < vecEnt.size(); ient++)
+    {
+        if (vecEnt[ient].ftg != kftgContent)
+            continue;
+        FNI fni;
+        if (!FFniInDir(pfniDir, vecEnt[ient].stnFile, &fni))
+            continue;
+        PCFL pcfl = CFL::PcflOpen(&fni, fcflNil);
+        if (pvNil == pcfl)
+            continue;
+        int32_t ccki = pcfl->Ccki();
+        std::map<int32_t, std::pair<int32_t, std::string>> mpClash; // other file -> (count, an example)
+        for (int32_t icki = 0; icki < ccki; icki++)
+        {
+            CKI cki;
+            if (!pcfl->FGetCki(icki, &cki))
+                continue;
+            auto key = std::make_pair((uint32_t)cki.ctg, (uint32_t)cki.cno);
+            auto it = mpOwner.find(key);
+            if (it == mpOwner.end())
+            {
+                mpOwner[key] = (int32_t)ient;
+            }
+            else if (it->second != (int32_t)ient)
+            {
+                cConflicts++;
+                auto &clash = mpClash[it->second];
+                if (clash.first++ == 0)
+                {
+                    clash.second = StdFormat("%c%c%c%c %u", (char)(cki.ctg >> 24), (char)(cki.ctg >> 16),
+                                             (char)(cki.ctg >> 8), (char)cki.ctg, (unsigned)cki.cno);
+                }
+            }
+        }
+        for (auto &kv : mpClash)
+        {
+            pvecLog->push_back(StdFormat("conflict: %d chunks of %s have the same type and number as chunks of %s "
+                                         "(for example %s). 3DMM will only use one of each pair.",
+                                         (int)kv.second.first, vecEnt[ient].stnFile.c_str(),
+                                         vecEnt[kv.first].stnFile.c_str(), kv.second.second.c_str()));
+        }
+        ReleasePpo(&pcfl);
+    }
+    return cConflicts;
+}
+
+void VxpInstall(PFNI pfniMsKids, PFNI pfniVxpDir, VXPSTATS *pstats)
+{
+    AssertPo(pfniMsKids, ffniDir);
+    AssertPo(pfniVxpDir, ffniDir);
+    AssertVarMem(pstats);
+
+    std::deque<FNI> vecFniVxp; // FNI can be assigned but not copy constructed
+    std::vector<VXPENT> vecEnt;
+    std::vector<std::string> vecLog;
+    FNI fniExp;
+    bool fHaveExp;
+    bool fChanged = fFalse;
+
+    ClearPb(pstats, SIZEOF(VXPSTATS));
+
+    // What VXPs are there?  (a missing directory is the same as an empty one:
+    // then only old unpacked files are cleaned up)
+    if (pfniVxpDir->TExists() == tYes)
+    {
+        FNE fne;
+        FNI fni;
+        FTG ftgVxp = kftgVxp;
+        if (fne.FInit(pfniVxpDir, &ftgVxp, 1))
+        {
+            while (fne.FNextFni(&fni))
+            {
+                vecFniVxp.emplace_back();
+                vecFniVxp.back() = fni;
+            }
+        }
+    }
+    pstats->cVxp = (int32_t)vecFniVxp.size();
+
+    for (size_t ivxp = 0; ivxp < vecFniVxp.size(); ivxp++)
+    {
+        std::string sError;
+        STN stnLeaf;
+        vecFniVxp[ivxp].GetLeaf(&stnLeaf);
+        if (!FReadVxp(&vecFniVxp[ivxp], (int32_t)ivxp, &vecEnt, &sError))
+        {
+            pstats->cFailed++;
+            vecLog.push_back(StdFormat("%s: skipped, %s", stnLeaf.Psz(), sError.c_str()));
+        }
+    }
+    pstats->cFiles = (int32_t)vecEnt.size();
+
+    fHaveExp = FFindExpansionsDir(pfniMsKids, !vecEnt.empty(), &fniExp);
+    if (!fHaveExp)
+    {
+        if (!vecEnt.empty())
+        {
+            pstats->cFailed++;
+            vecLog.push_back("can't find or create the Expansions directory");
+        }
+        WriteLog(pfniVxpDir, vecLog);
+        return;
+    }
+
+    // Delete unpacked files that don't belong to any VXP now (a VXP that was
+    // removed or replaced, or a half written file)
+    {
+        FNE fne;
+        FNI fni;
+        FTG rgftg[3] = {kftgContent, kftgThumbDesc, kftgVxpTemp};
+        std::set<std::string> setWanted;
+        std::deque<FNI> vecDelete;
+
+        for (size_t i = 0; i < vecEnt.size(); i++)
+            setWanted.insert(vecEnt[i].stnFile);
+
+        if (fne.FInit(&fniExp, rgftg, 3))
+        {
+            while (fne.FNextFni(&fni))
+            {
+                STN stnLeaf;
+                fni.GetLeaf(&stnLeaf);
+                std::string sLeaf = stnLeaf.Psz();
+                if (sLeaf.compare(0, strlen(kszVxpPrefix), kszVxpPrefix) != 0)
+                    continue; // not ours
+                if (setWanted.count(sLeaf) == 0 || FEndsWith(StdLower(sLeaf), ".vtp"))
+                {
+                    vecDelete.emplace_back();
+                    vecDelete.back() = fni;
+                }
+            }
+        }
+        for (size_t i = 0; i < vecDelete.size(); i++)
+        {
+            if (vecDelete[i].FDelete())
+            {
+                pstats->cRemoved++;
+                fChanged = fTrue;
+            }
+        }
+    }
+
+    // Unpack what isn't there yet
+    for (size_t ient = 0; ient < vecEnt.size(); ient++)
+    {
+        const VXPENT &ent = vecEnt[ient];
+        FNI fniOut, fniTmp;
+        std::string sError;
+
+        if (!FFniInDir(&fniExp, ent.stnFile, &fniOut))
+            continue;
+        if (fniOut.TExists() == tYes)
+        {
+            // same name means same crc; also check the size
+            PFIL pfil = FIL::PfilOpen(&fniOut);
+            bool fSame = (pvNil != pfil) && (pfil->FpMac() == (FP)ent.zent.cbSize);
+            ReleasePpo(&pfil);
+            if (fSame)
+                continue;
+            (void)fniOut.FDelete();
+        }
+
+        std::string sTmp = ent.stnFile.substr(0, ent.stnFile.rfind('.')) + ".vtp";
+        if (!FFniInDir(&fniExp, sTmp, &fniTmp))
+            continue;
+        STN stnVxpLeaf;
+        vecFniVxp[ent.ivxp].GetLeaf(&stnVxpLeaf);
+
+        if (!FUnpackEntry(&vecFniVxp[ent.ivxp], ent, &fniTmp, &sError) || !fniTmp.FRename(&fniOut))
+        {
+            if (sError.empty())
+                sError = "can't rename the file";
+            pstats->cFailed++;
+            vecLog.push_back(StdFormat("%s: couldn't unpack %s: %s", stnVxpLeaf.Psz(), ent.zent.name.c_str(),
+                                       sError.c_str()));
+            if (fniTmp.TExists() == tYes)
+                (void)fniTmp.FDelete();
+            continue;
+        }
+        pstats->cUnpacked++;
+        fChanged = fTrue;
+        vecLog.push_back(StdFormat("%s: unpacked %s as %s", stnVxpLeaf.Psz(), ent.zent.name.c_str(),
+                                   ent.stnFile.c_str()));
+    }
+
+    // Look for clashes only when something is new
+    if (fChanged)
+        pstats->cConflicts = CConflicts(&fniExp, vecEnt, &vecLog);
+
+    if (fChanged || pstats->cFailed > 0)
+        WriteLog(pfniVxpDir, vecLog);
+}
