+/***************************************************************************
+    Unpacks the v3DMM expansions (.vxp files) in the VXP directory into the
+    Expansions source, see vxp.h.  The directory is the VxpPath ini setting,
+    or a "VXP" directory in the Microsoft Kids directory if that is empty.
+***************************************************************************/
+void APP::_InstallVxps(void)
+{
+    AssertBaseThis(0);
+
+    SZ szPath;
+    STN stn;
+    FNI fniVxp;
+    VXPSTATS vxpstats;
+    bool fHaveDir = fFalse;
+
+    szPath[0] = chNil;
+    if (FGetSetRegKey(kszVxpPath, szPath, SIZEOF(szPath), fregString))
+    {
+        stn.SetSz(szPath);
+        if (stn.Cch() > 0)
+            fHaveDir = fniVxp.FBuildFromPath(&stn, kftgDir);
+    }
+    if (!fHaveDir)
+    {
+        // (a missing directory is fine: no expansions, but unpacked files of
+        // VXPs that are gone are still cleaned up)
+        _fniMsKidsDir.GetStnPath(&stn);
+        if (!stn.FAppendSz(kszVxpDirDefault) || !fniVxp.FBuildFromPath(&stn, kftgDir))
+            return;
+    }
+
+    VxpInstall(&_fniMsKidsDir, &fniVxp, &vxpstats);
+}
