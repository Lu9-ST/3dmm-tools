+        if (!FWriteFile(pfniTmp, vecData.data(), (uint32_t)vecData.size()))
+        {
+            *psError = "can't write the file";
+            return fFalse;
+        }
+        return fTrue;
+    }
+    catch (const std::exception &)
+    {
+        *psError = "out of memory";
