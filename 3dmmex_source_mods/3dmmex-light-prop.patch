+// Unpacked VXP files (without extension, lower case) that hold light props
+static std::set<std::string> _setLightFiles;
+
+/***************************************************************************
+    Remembers that content file pszLeafNoExt (like vxp_<name>_<crc>) is a
+    point light prop
+***************************************************************************/
+void TMPL::AddLightFile(const char *pszLeafNoExt)
+{
+    std::string s = pszLeafNoExt;
+    for (size_t i = 0; i < s.size(); i++)
+    {
+        if (s[i] >= 'A' && s[i] <= 'Z')
+            s[i] = (char)(s[i] - 'A' + 'a');
+    }
+    _setLightFiles.insert(s);
+}
+
+// Is this content file one of the light prop files?
+static bool _FLightFile(PCFL pcfl)
+{
+    if (_setLightFiles.empty())
+        return fFalse;
+
+    FNI fni;
+    STN stn;
+    pcfl->GetFni(&fni);
+    fni.GetLeaf(&stn);
+    std::string s = stn.Psz();
+    size_t ichDot = s.rfind('.');
+    if (ichDot != std::string::npos)
+        s.erase(ichDot);
+    for (size_t i = 0; i < s.size(); i++)
+    {
+        if (s[i] >= 'A' && s[i] <= 'Z')
+            s[i] = (char)(s[i] - 'A' + 'a');
+    }
+    return _setLightFiles.count(s) != 0;
+}
