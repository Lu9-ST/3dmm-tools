+// How far (in model units, for a prop that isn't scaled) a light prop reaches.  At that distance the light has
+// dropped to a fifth of what it is right next to the prop.
+static float _rLightRadius = 4.0f;
+// Brightness right next to the light, as a factor of kd * cos(angle).  The materials of 3DMM have kd = 0.6.
+static const float krLightGain = 1.0f / 0.6f;
+// How far above the origin of a light prop (in model units) its light is
+static const float kLightLift = 0.5f;
+// Most light props that light one render (BRender has room for 16 lights, and the background uses some)
+static const int32_t kcLightsMax = 6;
+
+bool BODY::_fHideLights = fFalse;
+int32_t BODY::_cLightsOn = 0;
+
+/***************************************************************************
+    Sets how far a light prop of normal size reaches
+***************************************************************************/
+void BODY::SetLightRadius(float rRadius)
+{
+    if (rRadius >= 0.1f && rRadius <= 1000.0f)
+        _rLightRadius = rRadius;
+}
+
+/***************************************************************************
+    Makes this BODY a point light prop (or not)
+***************************************************************************/
+void BODY::SetLight(bool fLight)
+{
+    AssertBaseThis(0);
+
+    _fLight = fLight;
+    if (fLight)
+    {
+        ClearPb(&_bactLight, SIZEOF(BACT));
+        ClearPb(&_blitLight, SIZEOF(BLIT));
+        _blitLight.type = BR_LIGHT_POINT;
+        _blitLight.colour = BR_COLOUR_RGB(0xff, 0xff, 0xff);
+        _bactLight.type = BR_ACTOR_LIGHT;
+        _bactLight.type_data = &_blitLight;
+        _bactLight.t.type = BR_TRANSFORM_MATRIX34;
+        BrMatrix34Identity(&_bactLight.t.t.mat);
+    }
+}
+
+/***************************************************************************
+    The movie started or stopped playing.  Light props can't be seen when
+    it plays.
+***************************************************************************/
+void BODY::SetPlaying(bool fPlaying, PBWLD pbwld)
+{
+    if (fPlaying != _fHideLights)
+    {
+        _fHideLights = fPlaying;
+        if (pvNil != pbwld)
+            pbwld->MarkDirty(); // the light props have to appear or disappear
+    }
+}
+
+/***************************************************************************
+    BWLD is about to render the world: if this is a light prop, hide it if
+    the movie is playing, and put its light in the world.
+***************************************************************************/
+void BODY::_AddLight(void)
+{
+    AssertThis(0);
+
+    BACT *pbactRoot = _PbactRoot();
+    float rScale, rRadius, rQ;
+    int32_t i;
+
+    _fLightOn = fFalse;
+    pbactRoot->render_style = _fHideLights ? BR_RSTYLE_NONE : BR_RSTYLE_DEFAULT;
+    if (_cLightsOn >= kcLightsMax || pvNil == _pbwld)
+        return;
+
+    // The scale of the prop is the average length of the axes of its matrix
+    rScale = 0.0f;
+    for (i = 0; i < 3; i++)
+    {
+        float rx = BrScalarToFloat(pbactRoot->t.t.mat.m[i][0]);
+        float ry = BrScalarToFloat(pbactRoot->t.t.mat.m[i][1]);
+        float rz = BrScalarToFloat(pbactRoot->t.t.mat.m[i][2]);
+        rScale += sqrtf(rx * rx + ry * ry + rz * rz);
+    }
+    rScale /= 3.0f;
+    if (rScale < 0.01f)
+        return;
+
+    // Intensity at distance d is kd * cos / (c + q * d * d); c makes it krLightGain next to the light, q
+    // makes it a fifth of that at rRadius.  (BRender measures d in the model space of what is lit, so the
+    // scale of what is lit changes how far the light seems to reach.)
+    rRadius = _rLightRadius * rScale;
+    rQ = (4.0f / krLightGain) / (rRadius * rRadius);
+    _blitLight.attenuation_c = BrFloatToScalar(1.0f / krLightGain);
+    _blitLight.attenuation_l = BrFloatToScalar(0.0f);
+    _blitLight.attenuation_q = BrFloatToScalar(rQ);
+
+    // The light is kLightLift above the origin of the prop (props sit on the floor: that's where the middle of the
+    // orb of a light prop is), along the up axis of the prop, which includes its scale.
+    for (i = 0; i < 3; i++)
+    {
+        _bactLight.t.t.mat.m[3][i] =
+            pbactRoot->t.t.mat.m[3][i] + BrFloatToScalar(kLightLift * BrScalarToFloat(pbactRoot->t.t.mat.m[1][i]));
+    }
+    _bactLight.identifier = (schar *)this;
+    _bactLight.type_data = &_blitLight; // (not in SetLight: Restore swaps BODYs)
+    _pbwld->AddActor(&_bactLight);
+    BrLightEnable(&_bactLight);
+    _fLightOn = fTrue;
+    _cLightsOn++;
+}
+
+/***************************************************************************
+    Rendering is done: take the light out of the world again.
+***************************************************************************/
+void BODY::_RemoveLight(void)
+{
+    AssertThis(0);
+
+    if (_fLightOn)
+    {
+        BrLightDisable(&_bactLight);
+        BrActorRemove(&_bactLight);
+        _fLightOn = fFalse;
+        _cLightsOn--;
+    }
+}
+
+void BODY::_EndRender(PBACT pbact)
+{
+    AssertVarMem(pbact);
+
+    PBODY pbody = PbodyFromBact(pbact);
+
+    if (pvNil != pbody && pbody->_fLight)
+        pbody->_RemoveLight();
+}
+
