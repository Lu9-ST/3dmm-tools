+static bool FReadEntry(PFNI pfniVxp, const zipread::ZipEntry &zent, std::vector<uint8_t> *pvecData,
+                       std::string *psError);
+
+// Does the text of a VXP's .cfg file say "Content=Light"?  (the .cfg is v3DMM's "Key=Value" file;
+// 3DMMEx uses the Content key to tell what kind of thing the VXP adds)
+static bool FCfgIsLight(const std::vector<uint8_t> &vecCfg)
+{
+    std::string s(vecCfg.begin(), vecCfg.end());
+    size_t ich = 0;
+
+    while (ich < s.size())
+    {
+        size_t ichEnd = s.find_first_of("\r\n", ich);
+        if (ichEnd == std::string::npos)
+            ichEnd = s.size();
+        std::string sLine = s.substr(ich, ichEnd - ich);
+        ich = ichEnd + 1;
+
+        size_t ichEq = sLine.find('=');
+        if (ichEq == std::string::npos)
+            continue;
+        std::string sKey = sLine.substr(0, ichEq);
+        std::string sVal = sLine.substr(ichEq + 1);
+        // trim (and skip a UTF-8 byte order mark)
+        if (sKey.compare(0, 3, "\xEF\xBB\xBF") == 0)
+            sKey.erase(0, 3);
+        const char *pszWs = " \t";
+        size_t ichA = sKey.find_first_not_of(pszWs), ichB = sKey.find_last_not_of(pszWs);
+        sKey = (ichA == std::string::npos) ? "" : sKey.substr(ichA, ichB - ichA + 1);
+        ichA = sVal.find_first_not_of(pszWs);
+        ichB = sVal.find_last_not_of(pszWs);
+        sVal = (ichA == std::string::npos) ? "" : sVal.substr(ichA, ichB - ichA + 1);
+        if (StdLower(sKey) == "content")
+            return StdLower(sVal) == "light";
+    }
+    return fFalse;
+}
