+/***************************************************************************
+    Shade table for textured objects.
+
+    The table that shipped with the game maps every texel to itself on every
+    row, so lighting has no effect on textures.  This builds a real table:
+    row r (0 = dark .. last = fully lit) maps each palette colour to the
+    palette entry that looks like that colour under that much light, using
+    the brightness curve of the game's own colour ramps (so a textured
+    surface reacts to light like a solid-colour one).  The row where a solid
+    colour shows its base shade (13 of 16) leaves the texture untouched.
+    Same algorithm as the shadetab.py tool, which can write the table into
+    3dmovie.chk.
+***************************************************************************/
+static void _Lab(const double *prgdRgb, double *prgd)
+{
+    double rgdLin[3];
+    for (int32_t i = 0; i < 3; i++)
+    {
+        double d = prgdRgb[i] / 255.0;
+        rgdLin[i] = d > 0.04045 ? pow((d + 0.055) / 1.055, 2.4) : d / 12.92;
+    }
+    double x = (0.4124 * rgdLin[0] + 0.3576 * rgdLin[1] + 0.1805 * rgdLin[2]) / 0.95047;
+    double y = (0.2126 * rgdLin[0] + 0.7152 * rgdLin[1] + 0.0722 * rgdLin[2]) / 1.0;
+    double z = (0.0193 * rgdLin[0] + 0.1192 * rgdLin[1] + 0.9505 * rgdLin[2]) / 1.08883;
+    double fx = x > 0.008856 ? cbrt(x) : 7.787 * x + 16.0 / 116.0;
+    double fy = y > 0.008856 ? cbrt(y) : 7.787 * y + 16.0 / 116.0;
+    double fz = z > 0.008856 ? cbrt(z) : 7.787 * z + 16.0 / 116.0;
+    prgd[0] = 116.0 * fy - 16.0;
+    prgd[1] = 500.0 * (fx - fy);
+    prgd[2] = 200.0 * (fy - fz);
+}
+
+static void _RgbFromPal(uint32_t lwRgb, double *prgd)
+{
+    prgd[0] = (double)((lwRgb >> 16) & 0xFF);
+    prgd[1] = (double)((lwRgb >> 8) & 0xFF);
+    prgd[2] = (double)(lwRgb & 0xFF);
+}
+
+static double _DLuma(uint32_t lwRgb)
+{
+    return 0.299 * (double)((lwRgb >> 16) & 0xFF) + 0.587 * (double)((lwRgb >> 8) & 0xFF) +
+           0.114 * (double)(lwRgb & 0xFF);
+}
+
+// Is every row of the (width x height) shade table the identity?
+static bool _FIdentityShadeTable(const uint8_t *prgb, int32_t cbRow, int32_t dxp, int32_t dyp)
+{
+    for (int32_t iy = 0; iy < dyp; iy++)
+        for (int32_t ix = 0; ix < dxp; ix++)
+            if (prgb[iy * cbRow + ix] != ix)
+                return fFalse;
+    return fTrue;
+}
+
+static void _FillShadeTable(uint8_t *prgb, int32_t cbRow, int32_t dxp, int32_t dyp, bool fIdentity)
+{
+    int32_t ix, iy, iclr;
+
+    for (iy = 0; iy < dyp; iy++)
+        for (ix = 0; ix < dxp; ix++)
+            prgb[iy * cbRow + ix] = (uint8_t)ix;
+    if (fIdentity || dyp < 2)
+        return;
+
+    // average brightness of ramp shades 0..7 relative to shade 6
+    double rgdProfile[kcShadesPerRamp];
+    for (int32_t ish = 0; ish < kcShadesPerRamp; ish++)
+    {
+        double dSum = 0;
+        for (int32_t ir = 0; ir < kcRamps; ir++)
+        {
+            int32_t iclrBase = kiclrRampFirst - kiclrPalFirst + ir * kcShadesPerRamp;
+            double dBase = _DLuma(_rglwPalette[iclrBase + kiShadeBase]);
+            dSum += _DLuma(_rglwPalette[iclrBase + ish]) / (dBase > 1.0 ? dBase : 1.0);
+        }
+        rgdProfile[ish] = dSum / kcRamps;
+    }
+
+    // brightness factor of each row; 1.0 at the "normally lit" row (13 of 16)
+    auto pfnCurve = [&](double dt) {
+        double dPos = dt * (kcShadesPerRamp - 1);
+        int32_t i0 = (int32_t)dPos;
+        if (i0 >= kcShadesPerRamp - 1)
+            return rgdProfile[kcShadesPerRamp - 1];
+        return rgdProfile[i0] + (rgdProfile[i0 + 1] - rgdProfile[i0]) * (dPos - i0);
+    };
+    double dRef = pfnCurve(13.0 / 15.0);
+    double *prgdLab = (double *)malloc(kcclrPal * 3 * sizeof(double));
+    if (prgdLab == pvNil)
+        return;
+    for (iclr = 0; iclr < kcclrPal; iclr++)
+    {
+        double rgdRgb[3];
+        _RgbFromPal(_rglwPalette[iclr], rgdRgb);
+        _Lab(rgdRgb, prgdLab + 3 * iclr);
+    }
+
+    for (iy = 0; iy < dyp; iy++)
+    {
+        double dFac = pfnCurve((double)iy / (double)(dyp - 1)) / dRef;
+        if (fabs(dFac - 1.0) < 1e-9)
+            continue;
+        for (iclr = 0; iclr < kcclrPal; iclr++)
+        {
+            double rgdSrc[3], rgdTgt[3], rgdLabT[3];
+
+            _RgbFromPal(_rglwPalette[iclr], rgdSrc);
+            for (int32_t ic = 0; ic < 3; ic++)
+            {
+                // brighter than the base shade: the ramps tint toward white there
+                double d = dFac < 1.0 ? rgdSrc[ic] * dFac : rgdSrc[ic] + (255.0 - rgdSrc[ic]) * (dFac - 1.0) * 1.6;
+                rgdTgt[ic] = d < 0 ? 0 : (d > 255.0 ? 255.0 : d);
+            }
+            _Lab(rgdTgt, rgdLabT);
+            int32_t iclrBest = 0;
+            double dBest = 1e300;
+            for (int32_t ic = 0; ic < kcclrPal; ic++)
+            {
+                double d0 = prgdLab[3 * ic] - rgdLabT[0], d1 = prgdLab[3 * ic + 1] - rgdLabT[1],
+                       d2 = prgdLab[3 * ic + 2] - rgdLabT[2];
+                double dDist = d0 * d0 + d1 * d1 + d2 * d2;
+                if (dDist < dBest)
+                {
+                    dBest = dDist;
+                    iclrBest = ic;
+                }
+            }
+            if (kiclrPalFirst + iclr < dxp)
+                prgb[iy * cbRow + kiclrPalFirst + iclr] = (uint8_t)(kiclrPalFirst + iclrBest);
+        }
+    }
+    free(prgdLab);
+}
+
 /***************************************************************************
     Call this function to assign the global shade table.  It is read from
     the given chunk.
+
+    fShadeTextures says whether textured objects should react to light:
+      fFalse - the shade table is forced to the identity (every row maps a
+               texel to itself), which is how the original game looks, even
+               if the content has a real table
+      fTrue  - a real table in the content is used as is; if the content's
+               table is the stock all-identity one, a real one is generated
 ***************************************************************************/
-bool MTRL::FSetShadeTable(PCFL pcfl, CTG ctg, CNO cno)
+bool MTRL::FSetShadeTable(PCFL pcfl, CTG ctg, CNO cno, bool fShadeTextures)
 {
     AssertPo(pcfl, 0);
 
     ReleasePpo(&_ptmapShadeTable);
     _ptmapShadeTable = TMAP::PtmapRead(pcfl, ctg, cno);
-    return (pvNil != _ptmapShadeTable);
+    if (pvNil == _ptmapShadeTable)
+        return fFalse;
+
+    BPMP *pbpmp = _ptmapShadeTable->Pbpmp();
+    if (pbpmp->type == BR_PMT_INDEX_8 && pbpmp->width == 256 && pbpmp->height >= 2 && pbpmp->pixels != pvNil)
+    {
+        uint8_t *prgb = (uint8_t *)pbpmp->pixels;
+        bool fIdentity = _FIdentityShadeTable(prgb, pbpmp->row_bytes, pbpmp->width, pbpmp->height);
+
+        if (!fShadeTextures)
+        {
+            if (!fIdentity)
+                _FillShadeTable(prgb, pbpmp->row_bytes, pbpmp->width, pbpmp->height, fTrue);
+        }
+        else if (fIdentity)
+        {
+            _FillShadeTable(prgb, pbpmp->row_bytes, pbpmp->width, pbpmp->height, fFalse);
+        }
+    }
+    return fTrue;
 }
 
