+PTMAP MTRL::_ptmapFlatTable = pvNil;  // identity shade table for content that is not to be shaded
+static std::vector<std::string> _vecFlatContent;
+
+static std::string _StdLowerNoExt(const char *psz)
+{
+    std::string s;
+    for (; *psz != 0; psz++)
+        s += (char)tolower((unsigned char)*psz);
+    size_t ich = s.rfind('.');
+    if (ich != std::string::npos && (s.compare(ich, std::string::npos, ".vxp") == 0 ||
+                                     s.compare(ich, std::string::npos, ".3cn") == 0))
+        s.erase(ich);
+    return s;
+}
+
+void MTRL::SetFlatContent(PCSZ pszList)
+{
+    _vecFlatContent.clear();
+    if (pszList == pvNil)
+        return;
+    std::string sItem;
+    for (const char *p = pszList;; p++)
+    {
+        if (*p == ',' || *p == ';' || *p == 0)
+        {
+            // trim
+            size_t ichFirst = sItem.find_first_not_of(" \t");
+            size_t ichLast = sItem.find_last_not_of(" \t");
+            if (ichFirst != std::string::npos)
+            {
+                std::string s = _StdLowerNoExt(sItem.substr(ichFirst, ichLast - ichFirst + 1).c_str());
+                if (!s.empty())
+                    _vecFlatContent.push_back(s);
+            }
+            sItem.clear();
+            if (*p == 0)
+                break;
+        }
+        else
+            sItem += *p;
+    }
+}
+
+// Is this content file one that is to be drawn without shading?  An unpacked VXP is called vxp_<name>_<crc>.3cn
+static bool _FFlatContent(PCFL pcfl)
+{
+    if (_vecFlatContent.empty())
+        return fFalse;
+
+    FNI fni;
+    STN stn;
+    pcfl->GetFni(&fni);
+    fni.GetLeaf(&stn);
+    std::string sLeaf = _StdLowerNoExt(stn.Psz());
+    for (size_t i = 0; i < _vecFlatContent.size(); i++)
+    {
+        const std::string &s = _vecFlatContent[i];
+        // vxp_<name>_<8 hex digits of the crc>
+        if (sLeaf == s || (sLeaf.size() == s.size() + 13 && sLeaf.compare(0, s.size() + 5, "vxp_" + s + "_") == 0))
+            return fTrue;
+    }
+    return fFalse;
+}
 
